    <section name="entityFramework" type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089" requirePermission="false" />
  </configSections>
  <connectionStrings>
    <!--
			CẤU HÌNH ĐƠN VỊ (dùng khi chạy local): Di Linh (DLH).
			Khi Publish, chọn profile của đơn vị (Properties/PublishProfiles/{MÃ}_{Tên}.pubxml);
			Web.{MÃ}_{Tên}.config sẽ tự ghi đè: WebDbContext, Region, DomainMedia, MediaAppName, MediaKey.
			Đổi đơn vị chạy local: copy 5 giá trị trên từ file Web.{MÃ}_{Tên}.config tương ứng.
		-->
    <add name="WebDbContext" connectionString="data source=20.10.10.156,1433;initial catalog=VNPT.Web.TruongHoc.DLH;persist security info=True;user id=VNPT.Web.TruongHoc.DLH;password=TruongHoc#$123;MultipleActiveResultSets=True;App=EntityFramework;Connection Timeout=3600" providerName="System.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <!-- Mã đơn vị: phải khớp với đuôi tên DB (VD: ...TruongHoc.DLH), sai sẽ báo lỗi khi khởi động -->
    <add key="Region" value="DLH" />
    <add key="DomainMedia" value="https://mediadilinh.lamdongtructuyen.vn/" />
    <add key="MediaAppName" value="TruongHoc" />
    <add key="MediaKey" value="63fae18d931c49d4bd6885a229f8eaa4" />
    <add key="webpages:Version" value="3.0.0.0" />
    <add key="webpages:Enabled" value="false" />
    <add key="ClientValidationEnabled" value="true" />
    <add key="UnobtrusiveJavaScriptEnabled" value="true" />
    <add key="EmailSmtpServer" value="smtp.gmail.com" />
    <add key="EmailSmtpPort" value="587" />
    <add key="EmailEnableSSL" value="true" />
    <add key="EmailSmtpUsername" value="ttcntt.vnptldg2024@gmail.com" />
    <add key="EmailSmtpPassword" value="murumtrtweudjgxy" />
    <add key="EmailSentFrom" value="Phòng giáo dục Bảo Lộc - OTP" />
    <!-- <add key="MenuCode" value="Portal" /> -->
  </appSettings>
  <system.web>
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" maxRequestLength="51200" />
    <!-- Đọc .cshtml là UTF-8 kể cả khi file bị lưu mất BOM (tránh lỗi font tiếng Việt) -->
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" />
