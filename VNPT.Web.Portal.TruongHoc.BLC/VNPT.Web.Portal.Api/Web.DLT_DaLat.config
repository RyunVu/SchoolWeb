<?xml version="1.0" encoding="utf-8"?>
<!--
  Cấu hình đơn vị: Đà Lạt (DLT)
  Tự động áp dụng khi Publish bằng profile "DLT_DaLat" (sau Web.Release.config).
  4 giá trị DB + DomainMedia + MediaAppName + MediaKey luôn đi cùng nhau, chỉ sửa trong file này.
-->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <connectionStrings>
    <add name="WebDbContext" connectionString="data source=20.10.10.153,1433;initial catalog=VNPT.Website.TruongHoc.DLT;persist security info=True;user id=VNPT.Website.TruongHoc.DLT;password=TruongHoc#$153;MultipleActiveResultSets=True;App=EntityFramework;Connection Timeout=3600" xdt:Transform="SetAttributes" xdt:Locator="Match(name)" />
  </connectionStrings>
  <appSettings>
    <add key="Region" value="DLT" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="DomainMedia" value="https://igovmedia.lamdongtructuyen.vn" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="MediaAppName" value="Website.TruongHoc.DaLat" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="MediaKey" value="8f26f588cc124aedb5ce01f0eaf66d7e" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  </appSettings>
</configuration>
