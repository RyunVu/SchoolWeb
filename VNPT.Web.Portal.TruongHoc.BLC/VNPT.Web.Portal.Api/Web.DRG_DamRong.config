<?xml version="1.0" encoding="utf-8"?>
<!--
  Cấu hình đơn vị: Đam Rông (DRG)
  Tự động áp dụng khi Publish bằng profile "DRG_DamRong" (sau Web.Release.config).
  4 giá trị DB + DomainMedia + MediaAppName + MediaKey luôn đi cùng nhau, chỉ sửa trong file này.
-->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <connectionStrings>
    <add name="WebDbContext" connectionString="data source=20.10.10.171;initial catalog=VNPT.Web.Portal.TruongHoc.DRG;persist security info=True;user id=VNPT.Web.Portal.TruongHoc.DRG;password=TruongHoc#$113;MultipleActiveResultSets=True;App=EntityFramework;Connection Timeout=3600" xdt:Transform="SetAttributes" xdt:Locator="Match(name)" />
  </connectionStrings>
  <appSettings>
    <add key="Region" value="DRG" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="DomainMedia" value="https://medialamha.lamdongtructuyen.vn" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="MediaAppName" value="VNPT.Web.Portal.TruongHoc.LHA" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="MediaKey" value="3b6ec8be807743ee88281856077eb6af" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  </appSettings>
</configuration>
