<?xml version="1.0" encoding="utf-8"?>
<!--
  Cấu hình đơn vị: Đạ Huoai (DTH)
  Tự động áp dụng khi Publish bằng profile "DTH_DaHuoai" (sau Web.Release.config).
  4 giá trị DB + DomainMedia + MediaAppName + MediaKey luôn đi cùng nhau, chỉ sửa trong file này.
-->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <connectionStrings>
    <add name="WebDbContext" connectionString="data source=20.10.10.171;initial catalog=VNPT.Web.Portal.TruongHoc.DTH;persist security info=True;user id=VNPT.Web.Portal.TruongHoc.DTH;password=TruongHoc#$113;MultipleActiveResultSets=True;App=EntityFramework;Connection Timeout=3600" xdt:Transform="SetAttributes" xdt:Locator="Match(name)" />
  </connectionStrings>
  <appSettings>
    <add key="Region" value="DTH" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="DomainMedia" value="https://media2.lamdongtructuyen.vn" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="MediaAppName" value="WebPX" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="MediaKey" value="dzkrLHpniEoGtcLF4Kaa" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  </appSettings>
</configuration>
