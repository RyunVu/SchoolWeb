<?xml version="1.0" encoding="utf-8"?>
<!--
  Cấu hình đơn vị: Di Linh (DLH)
  Tự động áp dụng khi Publish bằng profile "DLH_DiLinh" (sau Web.Release.config).
  4 giá trị DB + DomainMedia + MediaAppName + MediaKey luôn đi cùng nhau, chỉ sửa trong file này.
-->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <connectionStrings>
    <add name="WebDbContext" connectionString="data source=20.10.10.156,1433;initial catalog=VNPT.Web.TruongHoc.DLH;persist security info=True;user id=VNPT.Web.TruongHoc.DLH;password=TruongHoc#$123;MultipleActiveResultSets=True;App=EntityFramework;Connection Timeout=3600" xdt:Transform="SetAttributes" xdt:Locator="Match(name)" />
  </connectionStrings>
  <appSettings>
    <add key="Region" value="DLH" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="DomainMedia" value="https://mediadilinh.lamdongtructuyen.vn/" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="MediaAppName" value="TruongHoc" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="MediaKey" value="63fae18d931c49d4bd6885a229f8eaa4" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  </appSettings>
</configuration>
