<?xml version="1.0" encoding="utf-8"?>
<!--
  Cấu hình đơn vị: Đức Trọng (DTG)
  Tự động áp dụng khi Publish bằng profile "DTG_DucTrong" (sau Web.Release.config).
  4 giá trị DB + DomainMedia + MediaAppName + MediaKey luôn đi cùng nhau, chỉ sửa trong file này.
-->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <connectionStrings>
    <add name="WebDbContext" connectionString="data source=20.10.10.156;initial catalog=VNPT.Web.Portal.TruongHoc.DTG;persist security info=True;user id=VNPT.Web.Portal.TruongHoc.DTG;password=TruongHoc#$113;MultipleActiveResultSets=True;App=EntityFramework;Connection Timeout=3600" xdt:Transform="SetAttributes" xdt:Locator="Match(name)" />
  </connectionStrings>
  <appSettings>
    <add key="Region" value="DTG" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="DomainMedia" value="https://mediaductrong.lamdongtructuyen.vn" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="MediaAppName" value="VNPT.Web.Portal.TruongHoc.DTG" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="MediaKey" value="098c4fdad1b24e28b54c0fe79ddc0873" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  </appSettings>
</configuration>
