@using VNPT.Core.Constants
@using VNPT.Web.Portal.Api.DTO
@using VNPT.Web.Portal.Api.Helper
@using VNPT.Web.Portal.Api.Models
@using VNPT.Web.Portal.Base

@{

}

@model List<News>

<div id="featured">
    <div class="left col-md-7 hidden-xs">
        <div class="ui-tabs-panel lefts item_active" style="display: block;">

        </div>
    </div>
    <div class="right col-md-5">
        <div class="site_block_title_top">
            <h3>
                <a href="#" class="titlepgddt">
                    <img class="iconp" src="~/Images/pgddt/event.png" />
                    @SystemParameterDto.Translate("Tin tức sự kiện")
                </a>
            </h3>
        </div>

        <div class="ct">
            <div class="ui-tabs-nav rights list_item_news box-news-home_center item">
                @foreach (var item in Model)
                {
                    <div class="ui-tabs-nav-item item-center">
                        <a class="img" data-date="@item.CreateDate.ToString("dd/MM/yyyy")" data-view="@item.CountView" aria-valuetext="@item.ShortContent" aria-label="@item.Title" href="@Url.Site("chi-tiet-tin-tuc", parameter: new { param = item.Alias })">
                            <img src="@(item.ImageUrl != null ? Url.Image(item.ImageUrl) : Html.Raw("/Images/noimage.png"))" alt="@item.Title">
                        </a>

                        <div class="title">
                            <h4><a href="@Url.Site("chi-tiet-tin-tuc", parameter: new { param = item.Alias })" title="">@item.Title</a></h4>
                            <span class="time">
                                <i class="fa fa-clock-o"></i>@item.CreateDate.ToString("dd/MM/yyyy")
                            </span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>
