@using VNPT.Core.Constants
@using VNPT.Web.Portal.Api.DTO
@using VNPT.Web.Portal.Api.Helper
@using VNPT.Web.Portal.Api.Models
@using VNPT.Web.Portal.Base

@model List<News>

<div class="box-news-home">
    @foreach (var item in Model.Take(1))
    {

        <div class="col-sm-5 box-news-home_left item">
            <a class="img" href="@Url.Site("chi-tiet-tin-tuc", parameter: new { param = item.Alias })" title="@item.Title">
                <img class="image-border" src="@(item.ImageUrl != null ? Url.Image(item.ImageUrl) : Html.Raw("/Images/noimage.png"))" alt="@item.Title">
            </a>
            <div class="title">
                <h4>
                    <a href="@Url.Site("chi-tiet-tin-tuc", parameter: new { param = item.Alias })">@item.Title</a>
                </h4>
                <span class="time"><i class="fa fa-clock-o"></i>@item.CreateDate.ToString("dd/MM/yyyy")</span>
            </div>
        </div>
    }

    <div class="col-sm-7 box-news-home_right item">
        <ul>
            @foreach (var item in Model.Skip(1).Take(4))
            {
                <li>
                    <a href="@Url.Site("chi-tiet-tin-tuc", parameter: new { param = item.Alias })" title="@item.Title">
                        @item.Title
                    </a>
                </li>

            }
        </ul>
    </div>
</div>