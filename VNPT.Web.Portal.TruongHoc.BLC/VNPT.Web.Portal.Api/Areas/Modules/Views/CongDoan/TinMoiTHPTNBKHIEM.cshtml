@using VNPT.Core.Constants
@using VNPT.Web.Portal.Api.DTO
@using VNPT.Web.Portal.Api.Helper
@using VNPT.Web.Portal.Api.Models
@using VNPT.Web.Portal.Base

<style>
    .caption {
        text-align: left;
        color: #000;
        font-weight: bold;
        overflow: hidden;
        text-overflow: ellipsis;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
    }

    .thpcbk {
        background: #fff;
        border: 1px solid #ddd;
    }
    .thpcbk .slide-item img {
        object-fit: cover;
        width: 100%;
        height: 189px;
    }

        .thpcbk .slide-item {
            padding: 14px;
        }

        .thpcbk div .date {
            padding: 5px 0;
            display: inline-block;
            font-size: 13px;
            color: #939393;
            font-style: italic
        }

</style>

@model List<News>

<div class="col-sm-12">
    <div class="site_block_title">
        <h3>
            <a href="#">
                <i class="fa fa-file-text"></i>
                Tin tức mới nhất
            </a>
        </h3>
    </div>
    <div id="image-slider-thpcbk" class="thpcbk">
        @foreach (var item in Model)
        {
            <a href="@Url.Site("chi-tiet-tin-tuc", parameter: new { param = item.Alias })">
                <div class="slide-item">
                    <div><img onerror="onerror=null;src='/Images/NoImage400x266.png';" src="@Url.Image(item.ImageUrl)" alt="@item.Title"></div>
                    <div class="caption captionthptbk">@item.Title</div>
                    @if (DateTime.TryParse(item.CreateDate.ToString(), out var parsedDate))
                    {
                        <div><span class="date"><i class="fa fa-calendar-o " aria-hidden="true"></i> @parsedDate.ToString("dd/MM/yyyy")</span></div>
                    }
                    else
                    {
                        <div><span class="date"><i class="fa fa-calendar-o " aria-hidden="true"></i> @item.CreateDate</span></div>
                    }
                </div>
            </a>
        }
    </div>
</div>



<script>

    $(function () {
        $('.captionthptbk').each(function () {
            const capitalizeText = $(this).text()
                .toLowerCase()
                .split(' ')
                .map(word => word.charAt(0).toUpperCase() + word.slice(1))
                .join(' ');
            $(this).text(capitalizeText);
        });
    });
</script>
