@using VNPT.Core.Constants
@using VNPT.Web.Portal.Api.DTO
@using VNPT.Web.Portal.Api.Helper
@using VNPT.Web.Portal.Api.Models
@using VNPT.Web.Portal.Base

@model List<News>
<div class="box-news-home_haft item">
	@foreach (var item in Model)
	{
		<div class="item-center">
			<a class="img" href="@Url.Site("chi-tiet-tin-tuc", parameter: new { param = item.Alias })" title="@item.Title">
				<img src="@(item.ImageUrl != null ? Url.Image(item.ImageUrl) : Html.Raw("/Images/noimage.png"))" alt="">
			</a>
			<div class="title">
				<h4><a href="@Url.Site("chi-tiet-tin-tuc", parameter: new { param = item.Alias })" title="@item.Title">@item.Title</a></h4>
				<span class="time">
					<i class="fa fa-clock-o"></i>@item.CreateDate.ToString("dd/MM/yyyy")
					<span style="padding-left: 5%;"><i class="fa fa-eye"></i>@item.CountView lượt xem</span>
				</span>
			</div>
		</div>
	}
</div>
