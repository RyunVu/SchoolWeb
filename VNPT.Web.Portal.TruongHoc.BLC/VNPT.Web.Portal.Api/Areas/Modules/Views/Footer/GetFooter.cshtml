@using VNPT.Core.Constants
@using VNPT.Web.Portal.Api.DTO
@using VNPT.Web.Portal.Api.Helper
@using VNPT.Web.Portal.Api.Models
@using System.Web

@{
	var infomation = Session["PortalInformation"] as PortalInformation;
	// Chứng nhận Tín Nhiệm Mạng: chỉ hiển thị khi đã có ảnh (Value2) và link xác thực cụ thể (Value4)
	var tinNhiemMang = SystemParameterDto.GetParameter("FOOTER", "TINNHIEMMANG", infomation.PortalCode.ToUpper());
	var coTinNhiemMang = ThemeHelper.HasTinNhiemMang(tinNhiemMang.Value2, tinNhiemMang.Value4);
}

<div class="top-footer">
</div>
@*<div class="bottom-footer">
		<div class="info">
			<h3>
				<a href="" title="">@ViewBag.name</a>
			</h3>
			<p>Trụ sở: @ViewBag.address</p>
			<p>Điện thoại: @ViewBag.phone</p>
			<p>Email: @ViewBag.email</p>
			<p>@ViewBag.license</p>
		</div>
	</div>*@

<div class="bottom-footer col-md-12">
    <div class="info col-md-2" style="padding-right: 20px; text-align: left; width: 15%; ">
        <img src="@Url.Image(SystemParameterDto.GetParameter("FOOTER", "LOGO", infomation.PortalCode.ToUpper()).Value2)">
    </div>
    <div class="col-md-4" style="text-align: left">
        <h3>
            @ViewBag.name
        </h3>
        <p>@ViewBag.description1</p>
        <p>@ViewBag.description2</p>
        <p>@ViewBag.description3</p>
    </div>
    <div class="col-md-4" style="text-align: left">
        <h3>
            @SystemParameterDto.Translate("LIÊN HỆ")
        </h3>
        <p>@SystemParameterDto.Translate("Địa chỉ"): @ViewBag.address</p>
        <p>@SystemParameterDto.Translate("Điện thoại"): @ViewBag.phone</p>
        <p>Email: @ViewBag.email</p>
    </div>

    <div class="info col-md-2" style="margin-top: 25px;">
        @if (coTinNhiemMang)
        {
            <a target="_blank" rel="noopener" href="@tinNhiemMang.Value4" title="Chứng nhận Tín Nhiệm Mạng">
                <img src="@Url.Image(tinNhiemMang.Value2)" alt="Tín Nhiệm Mạng">
            </a>
        }
        <iframe style="border: 0;" src="@SystemParameterDto.GetParameter("FOOTER", "MAP", infomation.PortalCode.ToUpper()).Value2" width="100%" height="150" allowfullscreen="allowfullscreen" loading="lazy"></iframe>
    </div>
</div>
