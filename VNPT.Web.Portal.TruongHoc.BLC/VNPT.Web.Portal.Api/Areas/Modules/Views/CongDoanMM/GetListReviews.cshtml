@using VNPT.Core.Constants
@using VNPT.Web.Portal.Api.Helper
@using VNPT.Web.Portal.Base
@using VNPT.Web.Portal.Api.Models
@using PagedList.Mvc;

@model  PagedList.IPagedList<SysPortalReviewModel>

<h3>Xếp hạng và đánh giá</h3>
<div class="text-center" style="padding-bottom: 10px;">
    <input type="hidden" class="rating" data-filled="fa fa-star fa-4x active-color" data-empty="fa fa-star fa-4x inactive-color" value="@Model[0].Avg" data-readonly />
    <br />
    <span style="font-size:20px"><b>@Model[0].Avg/5</b></span>
</div>       
@{
    foreach (var placeReview in Model)
    {
        <div class="list-RV">
            <div class="block-RV">
                <div class="box-RV item-RV">
                    <div class="content-RV">
                        @if (!string.IsNullOrEmpty(placeReview.Name))
                        {
                            <span class="user-RV"><i class="fa fa-user"></i><a>@placeReview.Name</a></span>
                        }
                        else
                        {
                            <span class="user-RV"><i class="fa fa-user"></i><a>Ẩn danh</a></span>
                        }
                        <input type="hidden" class="rating" data-filled="fa fa-star active-color" data-empty="fa fa-star inactive-color" value="@placeReview.Rate" data-readonly />
                        <br />
                        @if (!string.IsNullOrEmpty(placeReview.Content))
                        {
                            <span>@placeReview.Content</span>
                        }
                        else
                        {
                            <span>Không có nội dung đánh giá</span>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
}

@if (Model.Any())
{
    <div class="pagination-primary">
        @Html.PagedListPager(Model, page => Url.Action("GetListReviews", "CongDoanMM", new { pageNum = page, pageSize = ViewBag.CurrentPageSize }), PagedListRenderOptions.ClassicPlusFirstAndLast)
    </div>
}

<script src="~/Scripts/bootstrap-rating.js"></script>
<script>
    $(function () {
        $('.pagination-primary').on('click', 'a', function () {
            if (this.href.includes("GetListReviews")) {               
                $.ajax({
                    url: this.href,
                    type: 'GET',
                    cache: false,
                    success: function (result) {
                        setTimeout(function () {
                            $('#reviews_list').html(result);
                        }, 500)
                    }
                });
            }
            return false;
        });
    });
</script>


