@using VNPT.Web.Portal.Base
@using VNPT.Web.Portal.Api.Models;
@using VNPT.Web.Portal.Api.Helper

@model List<MenuModel>

<style>
    .sub-menu2 {
        top: 0 !important;
    }

        .sub-menu2:before {
            bottom: unset !important
        }

    @@media (min-width: 768px) and (max-width: 1199px) {
        .mm-listview .mm-next {
            right: 0% !important;
        }
    }
</style>

@helper CreateLink(MenuModel menu, bool isChild)
{
    if (menu.IsNewsImage)
    {
        <a @(menu.IsOpenBlankPage ? "target=\"_blank\"" : "") href="@menu.Action" class="menu-a @(isChild?"":"")" title="@menu.Title">
            <i class="fa fa-caret-right"></i>
            @menu.Title
        </a>
    }
    else if (!string.IsNullOrEmpty(menu.Action))
    {
        switch (menu.Action)
        {
            case "hoi-dap-truc-tuyen":
                <a @(menu.IsOpenBlankPage ? "target=\"_blank\"" : "") href="@(Url.Site(menu.Action).ToString())" title="@menu.Title" class="menu-a @(isChild?"":"")">
                    @if (isChild)
                    {
                        <i class="fa fa-caret-right"></i>
                    }
                    @menu.Title
                </a>
                break;
            case "login":
                <a @(menu.IsOpenBlankPage ? "target=\"_blank\"" : "") href="/admin" title="@menu.Title" class="menu-a @(isChild?"":"")">
                    @if (isChild)
                    {
                        <i class="fa fa-caret-right"></i>
                    }
                    @menu.Title
                </a>
                break;
            case "danh-sach-tin-tuc":
                <a @(menu.IsOpenBlankPage ? "target=\"_blank\"" : "") href="@(!string.IsNullOrEmpty(menu.Parameter) ? Url.Site(menu.Action, parameter: new { param = menu.Parameter }).ToString() : Url.Site(menu.Action).ToString())" title="@menu.Title" class="menu-a @(isChild?"":"")">
                    @if (isChild)
                    {
                        <i class="fa fa-caret-right"></i>
                    }
                    @menu.Title
                </a>
                break;
            case "chi-tiet-tin-tuc":
                var param = menu.Parameter?.Split('.').Last();
                <a @(menu.IsOpenBlankPage ? "target=\"_blank\"" : "") href="@(!string.IsNullOrEmpty(param) ? Url.Site(menu.Action, parameter: new { param = param }).ToString() : Url.Site(menu.Action).ToString())" title="@menu.Title" class="menu-a @(isChild?"":"")">
                    @if (isChild)
                    {
                        <i class="fa fa-caret-right"></i>
                    }
                    @menu.Title
                </a>
                break;
            default:
                <a @(menu.IsOpenBlankPage ? "target=\"_blank\"" : "") href="@(!string.IsNullOrEmpty(menu.Parameter) ? Url.Site(menu.Action, parameter: new { param = menu.Parameter }).ToString() : Url.Site(menu.Action).ToString())" title="@menu.Title" class="menu-a @(isChild?"":"")">
                    @if (isChild)
                    {
                        <i class="fa fa-caret-right"></i>
                    }
                    @menu.Title
                </a>
                break;
        }
    }
}

@foreach (var menu in Model)
{
    if (menu.Children.Count > 0)
    {
        <li class="li-submenu">
            <a class="menu-a">@menu.Title <i class="@(menu.Icon != null ? "fa fa-angle-down" : "")fa fa-angle-down"></i></a>
            @if (menu.Children.Count > 0)
            {
                <ul class="sub-menu" style="overflow:unset">
                    @foreach (var sub in menu.Children)
                    {
                        <li class="li-submenu2">
                            @if (sub.Action.CheckUrl())
                            {
                                <a target="_blank" href="@sub.Action" title="">
                                    <i class="fa fa-caret-right"></i>
                                    @sub.Title
                                </a>
                            }
                            else
                            {
                                if (sub.Children.Any())
                                {
                                    <a>
                                        <i class="fa fa-caret-right"></i>
                                        @sub.Title

                                    </a>
                                    <i class="fa fa-angle-right" style="position: absolute; right: 21px; top: 11px; font-size: 16px; color: #263238;"></i>
                                    <ul class="sub-menu2" style="top: 0">
                                        @foreach (var sub2 in sub.Children)
                                        {

                                            <li>
                                                @CreateLink(sub2, true)
                                                @*@if (sub2.Action.CheckUrl())
                                                                                                {
                                                                                                    <a target="_blank" href="@sub2.Action" title="">
                                                                                                        @sub2.Title
                                                                                                    </a>
                                                                                                }
                                                                                                else
                                                            {
                                                                                                    <a href="@(!string.IsNullOrEmpty(sub2.Parameter) ? Url.Site(sub2.Action, parameter: new { param = sub2.Parameter }).ToString() : Url.Site(sub2.Action).ToString())" title="">
                                                                                                        <i class="fa fa-caret-right"></i>
                                                                                                        @sub2.Title
                                                                                                    </a>
                                                    }*@
                                            </li>
                                        }
                                    </ul>
                                }
                                else
                                {
                                    @CreateLink(sub, true)
                                }
                            }
                        </li>
                    }
                </ul>
            }
        </li>
    }
    else
    {
        <li>
            @CreateLink(menu, false)
        </li>
    }
}

<script type="text/javascript">
    $(document).ready(function () {
        if ($(window).width() <= 1199) {
            $('#menu-mobile .sub-menu2').removeClass('sub-menu2');
            $('#menu-mobile i').remove();
        }
    });
</script>