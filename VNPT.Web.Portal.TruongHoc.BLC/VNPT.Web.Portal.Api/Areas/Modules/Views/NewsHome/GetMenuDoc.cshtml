@using VNPT.Web.Portal.Base
@using VNPT.Web.Portal.Api.Models;
@using VNPT.Web.Portal.Api.Helper

@model List<MenuModel>

@foreach (var menu in Model)
{
	if (menu.Children.Count() > 0)
	{
		<li>
			<a><i class="fa fa-caret-right"></i> @menu.Title</a>
			@if (menu.Children.Count() > 0)
			{
				<ul class="cus-ul-child">
					@foreach (var sub in menu.Children)
					{
						<li class="cus-li">
							@if (sub.Action.CheckUrl())
							{
                                <a target="_blank" href="@sub.Action" title="@sub.Title">
                                    <i class="fa fa-caret-right"></i> @sub.Title
                                </a>
							}
							else
							{
								<a href="@(sub.Parameter != null ? Url.Site(sub.Action , parameter: new { param = sub.Parameter }).ToString() : Url.Site(sub.Action).ToString() )" title="@sub.Title">
                                    <i class="fa fa-caret-right"></i> @sub.Title
								</a>
							}
						</li>
					}
				</ul>
			}
		</li>
	}
	else
	{
		<li class="cus-li">
			@if (menu.Action.CheckUrl())
			{
				<a target="_blank" href="@menu.Action" title="">
                    <i class="fa fa-caret-right"></i> @menu.Title
				</a>
			}
			else
			{
				<a href="@(menu.Parameter != null ? Url.Site(menu.Action , parameter: new { param = menu.Parameter }).ToString() : Url.Site(menu.Action).ToString())" title="">
                    <i class="fa fa-caret-right"></i> @menu.Title
				</a>
			}
		</li>
	}
}
