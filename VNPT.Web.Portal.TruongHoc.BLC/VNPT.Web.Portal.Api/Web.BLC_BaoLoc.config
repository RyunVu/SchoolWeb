<?xml version="1.0" encoding="utf-8"?>
<!--
  Cấu hình đơn vị: Bảo Lộc (BLC)
  Tự động áp dụng khi Publish bằng profile "BLC_BaoLoc" (sau Web.Release.config).
  4 giá trị DB + DomainMedia + MediaAppName + MediaKey luôn đi cùng nhau, chỉ sửa trong file này.
-->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <connectionStrings>
    <add name="WebDbContext" connectionString="data source=192.168.150.116,1433;initial catalog=VNPT.Web.Portal.TruongHoc.BLC;persist security info=True;user id=VNPT.Web.Portal.TruongHoc.BLC;password=TruongHoc#$123;MultipleActiveResultSets=True;App=EntityFramework;Connection Timeout=3600" xdt:Transform="SetAttributes" xdt:Locator="Match(name)" />
  </connectionStrings>
  <appSettings>
    <add key="Region" value="BLC" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="DomainMedia" value="https://media3.lamdongtructuyen.vn/" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="MediaAppName" value="TruongHocBLC" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="MediaKey" value="7fe5923b8c994dfb8cdd0b671336e249" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  </appSettings>
</configuration>
