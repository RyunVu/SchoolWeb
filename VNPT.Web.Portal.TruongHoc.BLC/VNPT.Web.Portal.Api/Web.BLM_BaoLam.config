<?xml version="1.0" encoding="utf-8"?>
<!--
  Cấu hình đơn vị: Bảo Lâm (BLM)
  Tự động áp dụng khi Publish bằng profile "BLM_BaoLam" (sau Web.Release.config).
  4 giá trị DB + DomainMedia + MediaAppName + MediaKey luôn đi cùng nhau, chỉ sửa trong file này.
-->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">
  <connectionStrings>
    <add name="WebDbContext" connectionString="data source=20.10.10.171;initial catalog=VNPT.Web.TruongHoc.BLM;persist security info=True;user id=VNPT.Web.TruongHoc.BLM;password=TruongHoc#$123;MultipleActiveResultSets=True;App=EntityFramework;Connection Timeout=3600" xdt:Transform="SetAttributes" xdt:Locator="Match(name)" />
  </connectionStrings>
  <appSettings>
    <add key="Region" value="BLM" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="DomainMedia" value="https://mediabaolam.lamdongtructuyen.vn/" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="MediaAppName" value="TruongHocBLM" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
    <add key="MediaKey" value="a0c5a00898504d75bce75fdb7a0072a9" xdt:Transform="SetAttributes" xdt:Locator="Match(key)" />
  </appSettings>
</configuration>
