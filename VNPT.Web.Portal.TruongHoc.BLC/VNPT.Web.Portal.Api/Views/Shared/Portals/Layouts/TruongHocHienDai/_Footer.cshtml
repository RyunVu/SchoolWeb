@using VNPT.Web.Portal.Api.DTO
@using VNPT.Web.Portal.Api.Helper
@using VNPT.Web.Portal.Api.Models
@{
    var infomation = Session["PortalInformation"] as PortalInformation;
    var code = infomation.PortalCode.ToUpper();
    Func<string, string> footer = key => SystemParameterDto.GetParameter("FOOTER", key, code).Value2;
    var tinNhiemMang = SystemParameterDto.GetParameter("FOOTER", "TINNHIEMMANG", code);
    var descriptions = new[] { footer("DESCRIPTION_1"), footer("DESCRIPTION_2"), footer("DESCRIPTION_3") }.Where(s => !string.IsNullOrWhiteSpace(s)).ToList();
    var map = footer("MAP");
}

<div class="hd-footer">
    <div class="container">
        <div class="row">
            <div class="col-md-5 col-sm-12 hd-footer-col">
                <div class="hd-footer-brand">
                    <img src="@Url.Image(footer("LOGO"))" alt="Logo" />
                    <h3>@footer("NAME")</h3>
                </div>
                @foreach (var line in descriptions)
                {
                    <p>@line</p>
                }
            </div>
            <div class="col-md-4 col-sm-6 hd-footer-col">
                <h4>@SystemParameterDto.Translate("Liên hệ")</h4>
                <ul class="hd-footer-contact">
                    <li><i class="fa fa-map-marker"></i><span>@footer("ADDRESS")</span></li>
                    <li><i class="fa fa-phone"></i><span>@footer("PHONE")</span></li>
                    <li><i class="fa fa-envelope-o"></i><span>@footer("EMAIL")</span></li>
                    @if (!string.IsNullOrEmpty(footer("LINK_FACEBOOK")))
                    {
                        <li><i class="fa fa-facebook-square"></i><a target="_blank" rel="noopener" href="@footer("LINK_FACEBOOK")">Facebook nhà trường</a></li>
                    }
                </ul>
                @* Chỉ hiển thị khi đơn vị đã có chứng nhận Tín Nhiệm Mạng (ảnh + link xác thực cụ thể) *@
                @if (ThemeHelper.HasTinNhiemMang(tinNhiemMang.Value2, tinNhiemMang.Value4))
                {
                    <a class="hd-footer-badge" target="_blank" rel="noopener" href="@tinNhiemMang.Value4" title="Chứng nhận Tín Nhiệm Mạng">
                        <img src="@Url.Image(tinNhiemMang.Value2)" alt="Tín Nhiệm Mạng" />
                    </a>
                }
            </div>
            <div class="col-md-3 col-sm-6 hd-footer-col">
                @if (!string.IsNullOrEmpty(map))
                {
                    <h4>@SystemParameterDto.Translate("Bản đồ")</h4>
                    <iframe class="hd-footer-map" src="@map" loading="lazy" allowfullscreen></iframe>
                }
            </div>
        </div>
    </div>
    <div class="hd-footer-bottom">
        <div class="container">
            <span>© @DateTime.Now.Year @footer("NAME"). @footer("LICENSE")</span>
        </div>
    </div>
</div>
