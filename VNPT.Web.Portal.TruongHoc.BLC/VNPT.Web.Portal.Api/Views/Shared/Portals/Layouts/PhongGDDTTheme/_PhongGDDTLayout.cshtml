	    function getCurrentDate() {
	        var date = new Date();
            var day_name = "";
            var lang = "vi";

            const cookies = document.cookie;
            const cookieArray = cookies.split('; ');

            for (let i = 0; i < cookieArray.length; i++) {
                const [name, value] = cookieArray[i].split('=');
                if (name === "Language_Portal") {
                    lang = decodeURIComponent(value);
                }
            }

	        // Lấy tên thứ của ngày hiện tại
	        switch (date.getDay()) {
	            case 0:
                    day_name = lang == "vi" ? "Chủ nhật" : "Sunday";
	                break;
	            case 1:
                    day_name = lang == "vi" ? "Thứ 2" : "Monday";
	                break;
	            case 2:
                    day_name = lang == "vi" ? "Thứ 3" : "Tuesday";
	                break;
	            case 3:
                    day_name = lang == "vi" ? "Thứ 4" : "Wednesday";
	                break;
	            case 4:
                    day_name = lang == "vi" ? "Thứ 5" : "Thursday";
	                break;
	            case 5:
                    day_name = lang == "vi" ? "Thứ 6" : "Friday";
	                break;
	            case 6:
                    day_name = lang == "vi" ? "Thứ 7" : "Saturday";
	        }

            var html = day_name + ", " + date.toLocaleString("en-GB");
	        $("#timeCurrent").html(html);
        }

