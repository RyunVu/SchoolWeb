        function formatDateString(string) {
            var d = new Date(string);
            return (d.getDate() < 9 ? ("0" + d.getDate()) : d.getDate()) + "/" + ((d.getMonth() + 1) < 9 ? ("0" + (d.getMonth() + 1)) : (d.getMonth() + 1)) + "/" + d.getFullYear();
        }

