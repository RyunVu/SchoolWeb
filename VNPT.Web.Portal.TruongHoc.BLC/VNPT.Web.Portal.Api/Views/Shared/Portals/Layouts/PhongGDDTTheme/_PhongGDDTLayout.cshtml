    <script>
        function navigateToSearch() {
            // Get the value of the keyword input field
            var keyword = document.getElementById("keyword").value;

            if (!keyword) {
                return;
            }

            var portalCode = document.getElementById("portalCode").value;

            // Construct the URL for the search page
            var searchUrl = "/tim-kiem?keyword=" + encodeURIComponent(keyword); // Modify the URL as per your search page URL

            // Navigate to the search page
            window.location.href = searchUrl;
        }


        $("#searchBtn").click(() => {
            navigateToSearch();
        });

        $("#keyword").keyup(e => {
            if (e && e.which == 13) {
                navigateToSearch();
            }
        });
    </script>
