                autoplay: true,          // Tự động chạy
                autoplaySpeed: 5000,     // Thời gian hiển thị mỗi slide (ms)
                dots: true,              // Hiển thị chấm chấm dưới để chuyển đến từng slide
                infinite: true,
                speed: 500,
            });

        });

