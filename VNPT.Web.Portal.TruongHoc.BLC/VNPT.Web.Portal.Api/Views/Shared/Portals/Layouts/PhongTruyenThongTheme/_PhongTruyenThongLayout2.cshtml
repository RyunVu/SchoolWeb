    <script type="text/javascript">

        function restoreAudioState() {
            var audio = document.getElementById("audioPlayer");

            // Kiểm tra nếu phần tử audio tồn tại
            if (!audio) return;

            // Lấy trạng thái nhạc từ localStorage
            var savedTime = localStorage.getItem("audioTime");
            var isPlaying = localStorage.getItem("audioPlaying");

            if (savedTime) {
                audio.currentTime = parseFloat(savedTime);
            }

            if (isPlaying === "true") {
                audio.play();
            }
        }

        function saveAudioState() {
            var audio = document.getElementById("audioPlayer");

            if (audio) {
                localStorage.setItem("audioTime", audio.currentTime);
                localStorage.setItem("audioPlaying", !audio.paused);
            }
        }

        // Khi trang load lần đầu hoặc load lại từ cache (back/forward)
        window.addEventListener("pageshow", function (event) {
            restoreAudioState();
        });

        // Lưu trạng thái nhạc mỗi 500ms
        document.addEventListener("DOMContentLoaded", function () {
            restoreAudioState();

            var audio = document.getElementById("audioPlayer");

            setInterval(saveAudioState, 500);
        });

        // Lưu trạng thái khi rời khỏi trang
        window.addEventListener("beforeunload", function () {
            saveAudioState();
        });

        var xuat_xu_vb = document.getElementById("xuat_xu_vb").value;
        var color = document.getElementById("color").value;

