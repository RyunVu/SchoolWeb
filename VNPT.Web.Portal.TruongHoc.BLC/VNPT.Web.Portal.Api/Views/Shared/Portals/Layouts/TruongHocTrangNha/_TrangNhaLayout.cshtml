@using VNPT.Web.Portal.Api.Helper
@using VNPT.Web.Portal.Api.Models
@using VNPT.Web.Portal.Api.DTO
@{
    var information = Session["PortalInformation"] as PortalInformation;
    var portalCode = information.PortalCode;
    var xuat_xu_vb = SystemParameterDto.GetParameter("XUAT_XU", "vb_cdgd", portalCode.ToUpper()).Description;
    var color = SystemParameterDto.GetParameter("COLOR", "COLOR", portalCode.ToUpper()).Value2;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="@Url.Image(SystemParameterDto.GetParameter("FOOTER", "LOGO", portalCode.ToUpper()).Value2)" rel="Shortcut Icon">
    @RenderSection("MetaData", required: false)
    @RenderSection("pluginStyles", required: false)

    @* Bộ CSS nền giữ nguyên để các module (chi tiết tin, hỏi đáp, văn bản...) vẫn hiển thị đúng *@
    <link href="~/Content/bootstrap.min.css" rel="stylesheet" />
    <link href="~/Content/jquery.mmenu.all.css" rel="stylesheet" />
    <link href="~/Content/jquery.mmenu.themes.css" rel="stylesheet" />
    <link href="~/Content/main.css" rel="stylesheet" />
    <link href="~/Content/animate.css" rel="stylesheet" />
    <link href="~/Content/owl.carousel.min.css" rel="stylesheet" />
    <link href="~/Content/owl.theme.default.min.css" rel="stylesheet" />
    <link href="~/Content/custom2.css" rel="stylesheet" />
    <link href="~/Content/custom.css" rel="stylesheet" />
    <link href="~/Content/define.css" rel="stylesheet" />
    <link href="~/Content/magnific-popup.css" rel="stylesheet" />
    <link href="~/Content/bootstrap-rating.css" rel="stylesheet" />
    <link href="~/fonts/font-awesome/css/font-awesome.min.css" type="text/css" rel="stylesheet">
    <link href="~/fonts/themify-icons/themify-icons.css" type="text/css" rel="stylesheet">
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.css" />
    <link rel="stylesheet" type="text/css" href="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick-theme.css" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Noto+Serif:ital,wght@0,400;0,600;0,700;1,400&family=Noto+Sans:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="~/Content/themes/truonghoc-trangnha.css?v=8" rel="stylesheet" />

    <script src="~/Scripts/jquery.js"></script>
    @Scripts.Render("~/bundles/modernizr")
    <script type="text/javascript" src="https://cdn.jsdelivr.net/npm/slick-carousel@1.8.1/slick/slick.min.js"></script>
    @if (!string.IsNullOrEmpty(ViewBag.GoogleMapKey))
    {
        <script async defer src="https://maps.googleapis.com/maps/api/js?key=@ViewBag.GoogleMapKey"></script>
    }
    @if (!string.IsNullOrEmpty(ViewBag.GoogleAnalytics))
    {
        <script async src="https://www.googletagmanager.com/gtag/js?id=@ViewBag.GoogleAnalytics"></script>
        <script>
            window.dataLayer = window.dataLayer || [];
            function gtag() { dataLayer.push(arguments); }
            gtag('js', new Date());
            gtag('config', '@ViewBag.GoogleAnalytics');
        </script>
    }
</head>
<body class="th-tn">
    <input id="portalCode" value="@portalCode" type="hidden" />
    <input id="xuat_xu_vb" value="@xuat_xu_vb" type="hidden" />
    <input id="color" value="@color" type="hidden" />

    @if (ViewBag.IsThemePreview == true)
    {
        <div class="th-preview-bar">
            <i class="fa fa-eye"></i> Đang xem thử giao diện <b>Trang nhã</b>.
            <a href="?giao-dien=mac-dinh">Quay về giao diện đang dùng</a>
        </div>
    }

    <div class="wrap tn-wrap">
        @Html.Partial("~/Views/Shared/Portals/Layouts/TruongHocTrangNha/_Header.cshtml")
        <main class="tn-main">
            @RenderBody()
        </main>
        @Html.Partial("~/Views/Shared/Portals/Layouts/TruongHocTrangNha/_Footer.cshtml")
    </div>

    <a href="#" class="tn-backtop" aria-label="Lên đầu trang"><i class="fa fa-angle-up"></i></a>

    <script src="~/Scripts/tether.min.js" type="text/javascript"></script>
    <script src="~/Scripts/bootstrap.min.js" type="text/javascript"></script>
    <script src="~/Scripts/wow.min.js" type="text/javascript"></script>
    <script src="~/Scripts/jquery-migrate-1.2.1.min.js" type="text/javascript"></script>
    <script src="~/Scripts/owl.carousel.min.js" type="text/javascript"></script>
    <script src="~/Scripts/jquery.mmenu.all.js" type="text/javascript"></script>
    <script>window.DomainMedia = "@System.Configuration.ConfigurationManager.AppSettings["DomainMedia"]";</script>
    <script src="~/Scripts/common.js?v=2" type="text/javascript"></script>
    <script src="~/Scripts/jquery.magnific-popup.js" type="text/javascript"></script>
    <script src="~/Scripts/jquery.validate.min.js"></script>
    <script src="~/Scripts/mustache.min.js"></script>
    <script src="~/Scripts/jquery.validate.unobtrusive.min.js"></script>
    <script src="~/Scripts/bootstrap-rating.js"></script>
    <script src='https://www.google.com/recaptcha/api.js?onload=onloadCallback&render=explicit' async defer></script>
    <script type="text/javascript">
        var xuat_xu_vb = document.getElementById("xuat_xu_vb").value;
        var color = document.getElementById("color").value;

        (function ($) {
            function pad(n) { return n < 10 ? "0" + n : n; }
            function tick() {
                var d = new Date();
                var days = ["Chủ nhật", "Thứ hai", "Thứ ba", "Thứ tư", "Thứ năm", "Thứ sáu", "Thứ bảy"];
                $("#timeCurrent").text(days[d.getDay()] + ", " + pad(d.getDate()) + "/" + pad(d.getMonth() + 1) + "/" + d.getFullYear());
            }

            function search(input) {
                var keyword = $.trim($(input).val());
                if (keyword) {
                    window.location.href = "/tim-kiem?keyword=" + encodeURIComponent(keyword);
                }
            }

            $(function () {
                tick();

                // Header thu gọn khi cuộn
                var $header = $(".tn-header");
                $(window).on("scroll", function () {
                    var y = $(window).scrollTop();
                    $header.toggleClass("is-stuck", y > 120);
                    $(".tn-backtop").toggleClass("show", y > 400);
                });
                $(".tn-backtop").on("click", function (e) { e.preventDefault(); $("html,body").animate({ scrollTop: 0 }, 400); });

                // Menu điện thoại: khởi tạo mmenu ở lần bấm đầu rồi mở luôn (common.js chỉ khởi tạo, phải bấm 2 lần)
                $(".tn-burger").on("click", function (e) {
                    e.preventDefault();
                    var $menu = $("#menu-mobile");
                    if (!$menu.data("mmenu")) {
                        $menu.mmenu({ extensions: ["pagedim-black"] });
                    }
                    var api = $menu.data("mmenu");
                    if (api) { api.open(); }
                });

                // Tìm kiếm
                $(".tn-search-form").on("submit", function (e) { e.preventDefault(); search($(this).find("input")); });

                // Banner đầu trang
                var heroCount = $("#tn-hero .tn-hero-item").length;
                if (heroCount) {
                    $("#tn-hero").owlCarousel({ items: 1, loop: heroCount > 1, autoplay: heroCount > 1, dots: heroCount > 1, autoplayTimeout: 5000, animateOut: "fadeOut", nav: false });
                }

                // Tin khác trong trang chi tiết
                $(".slide-news-home").owlCarousel({ margin: 20, dots: false, nav: true, navText: ['<i class="fa fa-angle-left"></i>', '<i class="fa fa-angle-right"></i>'], responsive: { 0: { items: 1 }, 600: { items: 2 }, 1000: { items: 3 } } });

                $('.popup-youtube').magnificPopup({ type: 'iframe', mainClass: 'mfp-fade', preloader: true });
                $('.tn-gallery').each(function () {
                    $(this).magnificPopup({ delegate: 'a.tn-gallery-zoom', type: 'image', gallery: { enabled: true } });
                });

                // Menu: đánh dấu mục đang mở
                var path = window.location.pathname + window.location.search;
                $("#menu-list a.menu-a").each(function () {
                    var href = $(this).attr("href");
                    if (href && href.length > 1 && path.indexOf(href.replace(/^https?:\/\/[^\/]+/, "")) === 0) {
                        $(this).closest("#menu-list > li").addClass("is-active");
                    }
                });
            });
        })(jQuery);
    </script>
    @RenderSection("pluginScripts", required: false)
    @RenderSection("scripts", required: false)
</body>
</html>
