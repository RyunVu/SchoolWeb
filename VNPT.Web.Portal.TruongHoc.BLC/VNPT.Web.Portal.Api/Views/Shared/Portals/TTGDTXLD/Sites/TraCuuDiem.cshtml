@section scripts {
    <script type="text/javascript">

        var data, chooseItem = null;

        var nameCongThongTin = document.getElementById("nameCongThongTin").value;
        var nameUBNDXA = document.getElementById("nameUBNDXA").value;
        var showeOffice = document.getElementById("showeOffice").value;

        function show_detail(item) {
            this.chooseItem = item;
            $.ajax({
                type: "POST",
                data: {
                    MaVnedu: item.MaVnedu,
                    Namhoc: item.Namhoc
                },
                url: '@Url.Action("GetDetail", "TraCuuDiem", new { area = "Modules" })',
                headers: { "Accept": "application/json; odata=verbose; charset=utf-8" },
                beforeSend: function () {

                },
                success: function (res) {
                    const template = $('#student-template').html();
                    const rendered = Mustache.render(template, res.Result);
                    $("#vanBanDetail").html(rendered);
                },
            });
        }

        function parseNestedXml(element, obj) {
            for (let i = 0; i < element.children.length; i++) {
                const child = element.children[i];
                obj[child.nodeName] = {};

                // Iterate through the child's attributes
                for (let j = 0; j < child.attributes.length; j++) {
                    const attribute = child.attributes[j];
                    obj[child.nodeName][attribute.nodeName] = attribute.nodeValue;
                }

                // Recursively iterate through the child's children
                if (child.children.length > 0) {
                    obj[child.nodeName] = parseNestedXml(child, obj[child.nodeName]);
                } else {
                    obj[child.nodeName]["#text"] = child.textContent;
                }
            }

            return obj;
        }

        var commonConfig = {
            pageSize: 15,
            pageNum: 1,
            isClear: 0,
            type: ""
        };

        var skip = commonConfig.pageSize * (commonConfig.pageNum - 1);

        var obj = {
            PageIndex: commonConfig.pageNum,
            PageSize: commonConfig.pageSize,
            IsPagination: true
        };

        //function getQueryParam(param) {
        //    var urlParams = new URLSearchParams(window.location.search);
        //    return urlParams.get(param);
        //}

        function selectOptionById(selectId, value) {
            $("#" + selectId).val(value).change();
        }

        //var cqbhValue = getQueryParam("cqbh");

        $("#bangDiemModal").on('click', '.exportFile', function () {
            if (chooseItem) {
                main.exportFile(chooseItem, true);
            }
        });

        var main = {
            exportFile: function (chooseItem, isloading) {
                if (isloading) {
                    loading.showLoading();
                }
                $.ajax({
                    type: "POST",
                    data: chooseItem,
                    url: '@Url.Action("ExportFile", "TraCuuDiem", new { area = "Modules" })',
                    beforeSend: function() {
                        if (isloading) {
                            loading.showLoading();
                        }
                    },
                    success: function (respon) {
                        window.open(respon.Result);
                        loading.hideLoading();
                    },
                    error: function (xhr, status, error) {
                        loading.hideLoading();
                        alert("Không thể thực hiện thao tác này vào lúc này!!!");
                    },
                    timeout: 20000
                });
            },
            loadNamHoc: function () {
                var currentYear = new Date().getFullYear() + 1;
                var $namHoc = $('#NamHoc');

                $namHoc.append($('<option>', {
                    value: '',
                    text: '-- Chọn năm --'
                }));

                for (let year = currentYear - 1; year >= 2020; year--) {
                    let nextYear = year + 1;
                    let namHocValue = `${year} - ${nextYear}`;
                    let namHocText = `${year} - ${nextYear}`;

                    $namHoc.append($('<option>', {
                        value: namHocValue,
                        text: namHocText
                    }));
                }
            },
            loadData: function (isloading, refresh) {
                if (refresh) {
                    commonConfig.pageSize = 15;
                    commonConfig.pageNum = 1;
                    commonConfig.isClear = 0;
                    obj = {
                        PageIndex: commonConfig.pageNum,
                        PageSize: commonConfig.pageSize
                    };
                }

                var skip = commonConfig.pageSize * (commonConfig.pageNum - 1);

                obj.Keyword = "";
                obj.NamHoc = "";

                var Keyword = $("#Keyword").val().trim();
                $("#Keyword").removeClass("error-border");

                if (Keyword) {
                    obj.Keyword = Keyword;
                } else {
                    $("#Keyword").addClass("error-border").focus();
                    return;
                }

                var NamHoc = $("#NamHoc").val();
                if (NamHoc != null && NamHoc != "") {
                    var txtNamHoc = $("#NamHoc option:selected").text();
                    obj.NamHoc = txtNamHoc;
                }

                obj.UnitCode = '@information.PortalCode.ToUpper()';
                obj.IsPagination = true;

                $.ajax({
                    type: "POST",
                    data: obj,
                    url: '@Url.Action("GetList", "TraCuuDiem", new { area = "Modules" })',
                    beforeSend: function () {
                        if (isloading) {
                            loading.showLoading();
                        }
                    },
                    success: function (respon) {
                        var res = respon.Result;
                        if (res.length > 0) {
                            var totalRow = respon.TotalRow;
                            $("#soVanBan").text("Tìm thấy " + totalRow + " thông tin")
                            var html = '';

                            $.each(res, function (key, item) {
                                html += "<tr data-toggle='modal' data-target='#bangDiemModal' style='cursor: pointer;' " +
                                    "onclick='show_detail(" + JSON.stringify(item).replace(/'/g, "\\'") + ")'>" +
                                    "<td><b>" + item.MaVnedu + "</b></td>" +
                                    "<td><b>" + item.Hovaten + "</b></td>" +
                                    "<td>" + item.Lop + "</td>" +
                                    "<td>" + item.Namhoc + "</td>" +
                                    "<td>" + item.DANHHIEU + "</td>" +
                                    "<td>" + item.LENLOP + "</td>" +
                                    "</tr>";
                            });

                            //off pt
                            //main.pagingPage(totalRow, commonConfig.isClear, function () {
                            //    main.loadData(true, false);
                            //});

                            $("#lstVanBanDetail").html(html);

                            var color = document.getElementById("color").value;
                            $('.pagination li.active a').css("background", color);

                        }
                        else {
                            $("#soVanBan").text("Tìm thấy 0 thông tin")

                            //off pt
                            //main.pagingPage(0, commonConfig.isClear, function () {
                            //    main.loadData(true, false);
                            //});

                            var html = '<tr><td colspan="6" style="text-align: center">Không tìm thấy dữ liệu</td></tr>'

                            $("#lstVanBanDetail").html(html);
                        }
                        if (isloading) {
                            loading.hideLoading();
                        }
                    },

                });
        },
        pagingPage: function (totalRow, isClear, callback) {
            var totalPage = Math.ceil(totalRow / commonConfig.pageSize);
            if (totalPage >= 0 && commonConfig.isClear == 0) {
                if (totalPage == 0) {
                    totalPage = 1;
                }
                $('#paginationholder').html('<ul id="pagination" class="pagination"></ul>');
            }

            $("#paginationholder #pagination").twbsPagination({
                totalPages: totalPage,
                visiblePages: 6,
                first: "<<",
                next: ">",
                last: ">>",
                prev: "<",
                initiateStartPageClick: false,
                onPageClick: function (event, pageNum) {
                    commonConfig.pageNum = pageNum;
                    commonConfig.isClear = 1;
                    obj = {
                        pageNum: commonConfig.pageNum,
                        pageSize: commonConfig.pageSize,
                    };
                    setTimeout(callback, 200);
                }
            });
        }
        }

        $(document).ready(function () {
            var width = $("#slide_news .sp-slides-container").outerWidth();
            $(".sp-caption-container").css({ "width": width + "px" });
            main.loadNamHoc();

            //setTimeout(function () {
            //    $.when(
            //        main.loadNamHoc(),
            //    ).done(function () {
            //        main.loadData(true, false);
            //    });
            //}, 500)
        })
    </script>
}
