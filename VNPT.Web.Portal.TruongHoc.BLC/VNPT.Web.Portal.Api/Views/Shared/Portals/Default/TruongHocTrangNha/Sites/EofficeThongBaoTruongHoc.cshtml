            <div class="content_row">
                <label class="label_van_ban_dieu_hanh" style="padding: 10px 0; font-weight: 700;" id="soVanBan">

                </label>
            </div>
            <div class="content_row">
                <div class="list-news-cate" id="lstVanBanPl">
                    <div class="table-text-system table-responsive ">
