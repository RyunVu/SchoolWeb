@using VNPT.Web.Portal.Api.DTO
@using VNPT.Web.Portal.Api.Code
@using VNPT.Web.Portal.Api.Models

@{
    Layout = ViewBag.Layout;
    var information = Session["PortalInformation"] as PortalInformation;
    var banner3 = SystemParameterDto.GetParameter("BANNER_CENTER3", null, information.PortalCode.ToUpper());
    var listbanner3 = SystemParameterDto.GetParameters("BANNER_CENTER3", information.PortalCode.ToUpper()).OrderBy(s => s.Id).ToList();
    var color = SystemParameterDto.GetParameter("COLOR", "COLOR", information.PortalCode.ToUpper()).Value2;
    var nameCongThongTin = SystemParameterDto.GetParameter("FOOTER", "NAME", information.PortalCode.ToUpper()).Value6;
    var nameUBNDXA = SystemParameterDto.GetParameter("FOOTER", "NAME", information.PortalCode.ToUpper()).Value7;
    var showeOffice = SystemParameterDto.GetParameter("DISPLAY", "EOFFICE", information.PortalCode.ToUpper()).Value5;
}

@section MetaData {
    @Html.Action("Index", "Metadata", new { area = "Modules", Type = MetaDataType.Portal, Keywords = ViewBag.Tag, Title = ViewBag.Title, Description = ViewBag.Description })
}
@section pluginStyles {
    <style>
        .askanswer .s-page-search .fg1 {
            width: calc(57% - 12px) !important;
        }

        .askanswer .item-QA.box-QA-question > i:after {
            width: 0px !important;
        }

        .askanswer .item-QA.box-QA-answer > i:after {
            height: 0 !important
        }

        .cls-h3 {
            text-align: center;
            border-bottom: 3px solid #0098d6;
        }

        .item-detail {
            cursor: pointer;
            float: right;
            font-style: italic;
        }

        .mfp-close {
            color: #000 !important;
        }
    </style>
}

<div class="container">
    <input id="nameCongThongTin" value="@nameCongThongTin" type="hidden" />
    <input id="nameUBNDXA" value="@nameUBNDXA" type="hidden" />
    <input id="showeOffice" value="@showeOffice" type="hidden" />
    <div class="row">
        <div class="col-md-8 col-md-push-4 askanswer">
