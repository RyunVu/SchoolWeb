                                    <th scope="col">Ngày ban hành</th>
                                    <th scope="col">Trích yếu</th>
                                </tr>
                            </thead>
                            <tbody id="lstVanBanDetail"></tbody>
                        </table>
                    </div>
                </div>
                <div class="pagination-primary" id="paginationholder">
                    <ul class="pagination" id="pagination"></ul>
                </div>
                <div class="loading-box" aria-hidden="true" style="display: none;">
                    <div class="box-show">
                        <div class="loading-page"></div>
                        <div class="box-content">Đang tải ...</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4 col-md-pull-8 sidebar-mobile-ontop">
            @Html.Partial("~/Views/Shared/Portals/Layouts/TruongHocTrangNha/_Sidebar.cshtml")
        </div>
    </div>

    <div class="modal fade"
         id="exampleModal"
         tabindex="-1"
         role="dialog"
         aria-labelledby="exampleModalLabel"
         aria-hidden="true" style="padding-top: 50px;">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header background_van_ban_dieu_hanh">
                    <h3 class="modal-title" id="exampleModalLabel" style="color:white">Nội dung chi tiết</h3>
                    @*<button type="button"
                                class="close"
                                data-dismiss="modal"
                                aria-label="Close">
                            <span aria-hidden="true">&times;</span>
                        </button>*@
                </div>
                <div class="modal-body">
                    <div id="vanBanDetail">

                    </div>
                </div>
                <div class="modal-footer">
                    @*<a id="duongDan" target="_blank" class="btn btn-primary" href="">Đường dẫn</a>*@
                    <button type="button"
                            class="btn btn-secondary background_van_ban_dieu_hanh"
                            data-dismiss="modal" style="color:white">
                        Đóng
                    </button>
                    @*<button type="button" class="btn btn-primary">Đường dẫn</button>*@

                </div>
            </div>
        </div>
    </div>

</div>

<script src="~/Scripts/jquery.twbsPagination.min.js"></script>

@section scripts {
	<script type="text/javascript">

        var data;

        var nameCongThongTin = document.getElementById("nameCongThongTin").value;
        var nameUBNDXA = document.getElementById("nameUBNDXA").value;
        var showeOffice = document.getElementById("showeOffice").value;

        function show_detail(id) {
            $.ajax({
                type: "POST",
                data: {
                    Id: id
                },
                url: '@Url.Action("GetDetailDoc", "EOfficeDoc", new { area = "Modules" })',
                headers: { "Accept": "application/json; odata=verbose; charset=utf-8" },
                beforeSend: function () {

                },
                success: function (res) {
                    var attachmentFile = "";
                    var lengthAttach = res.Attachments.length;
                    if (lengthAttach > 0) {
                        for (let i = 0; i < lengthAttach; i++) {
                            const itemAttach = res.Attachments[i];
                            attachmentFile += '<div><a target="_blank" href="' + itemAttach.Path + '">' + itemAttach.Name + '</a></div>'
                        }
                    }

                    var parts = res.NgayBanHanh.split('/');

                    // Rearrange the parts to the desired format
                    var formattedDate = parts[1] + '/' + parts[0] + '/' + parts[2];

                    var html = '<div class="content_row">'
						+ '<div class="col-md-12 detail_van_ban_dieu_hanh"><div class="col-md-4"><label>Số/Ký hiệu</label></div><div class="col-md-8"><label>' + res.SoKyHieu + '</label></div></div>'
                        + '<div class="col-md-12 detail_van_ban_dieu_hanh"><div class="col-md-4"><label>Ngày ban hành</label></div><div class="col-md-8"><label>' + formattedDate + '</label></div></div>'
						+ '<div class="col-md-12 detail_van_ban_dieu_hanh"><div class="col-md-4"><label>Người ký</label></div><div class="col-md-8"><label>' + res.NguoiKy + '</label></div></div>'
						+ '<div class="col-md-12 detail_van_ban_dieu_hanh"><div class="col-md-4"><label>Trích yếu</label></div><div class="col-md-8"><label>' + res.TrichYeu + '</label></div></div>'
						+ '<div class="col-md-12 detail_van_ban_dieu_hanh"><div class="col-md-4"><label>Cơ quan ban hành</label></div><div class="col-md-8"><label>' + res.CoQuanBanHanh + '</label></div></div>'
						+ '<div class="col-md-12 detail_van_ban_dieu_hanh"><div class="col-md-4"><label>Loại văn bản</label></div><div class="col-md-8"><label>' + res.LoaiVanBan + '</label></div></div>'
						+ '<div class="col-md-12 detail_van_ban_dieu_hanh"><div class="col-md-4"><label>Lĩnh Vực</label></div><div class="col-md-8"><label>' + res.LinhVuc + '</label></div></div>'
						+ '<div class="col-md-12 detail_van_ban_dieu_hanh"><div class="col-md-4"><label>Công báo số</label></div><div class="col-md-8"><label>' + res.CongBaoSo + '</label></div></div>'
						+ '<div class="col-md-12 detail_van_ban_dieu_hanh"><div class="col-md-4"><label>Ngày phát hành công báo</label></div><div class="col-md-8"><label>' + res.NgayPhatHanh + '</label></div></div>'
						+ '<div class="col-md-12 detail_van_ban_dieu_hanh"><div class="col-md-4"><label>Hiệu lực</label></div><div class="col-md-8"><label>' + res.HieuLuc + '</label></div></div>'
						+ '<div class="col-md-12 detail_van_ban_dieu_hanh"><div class="col-md-4"><label>Ghi chú</label></div><div class="col-md-8"><label>' + res.GhiChu + '</label></div></div>'
						+ '<div class="col-md-12 detail_van_ban_dieu_hanh"><div class="col-md-4"><label>Đính kèm</label></div><div class="col-md-8"><label>' + attachmentFile + '</label></div></div>'
						+ '</div>';
                    $("#vanBanDetail").html(html);
                },
            });
        }

        function parseNestedXml(element, obj) {
            for (let i = 0; i < element.children.length; i++) {
                const child = element.children[i];
                obj[child.nodeName] = {};

                // Iterate through the child's attributes
                for (let j = 0; j < child.attributes.length; j++) {
                    const attribute = child.attributes[j];
                    obj[child.nodeName][attribute.nodeName] = attribute.nodeValue;
                }

                // Recursively iterate through the child's children
                if (child.children.length > 0) {
                    obj[child.nodeName] = parseNestedXml(child, obj[child.nodeName]);
                } else {
                    obj[child.nodeName]["#text"] = child.textContent;
                }
            }

            return obj;
        }

        var commonConfig = {
            pageSize: 25,
            pageNum: 1,
            isClear: 0,
            type: ""
        };

        var skip = commonConfig.pageSize * (commonConfig.pageNum - 1);

        var obj = {
            pageNum: commonConfig.pageNum,
            pageSize: commonConfig.pageSize
        };

        var main = {
            loadDocTypeList: function () {
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("GetListCategory", "EOfficeDoc", new { area = "Modules", Code = CategoryCode.LOAIVANBAN })',
                    headers: { "Accept": "application/json; odata=verbose; charset=utf-8" },
                    beforeSend: function () {

                    },
                    success: function (res) {
                        var htmlLoaiVanBan = '';
                        htmlLoaiVanBan += '<option value ="">-- Toàn bộ --</option>';
                        $.each(res, function (key, item) {
                            htmlLoaiVanBan += '<option value ="' + item.ID + '">' + item.NAME + '</option>';
                        });
                        $("#loaiVanBan").append(htmlLoaiVanBan);
                    },
                });
            },
            loadFieldList: function () {
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("GetListCategory", "EOfficeDoc", new { area = "Modules", Code = CategoryCode.LINHVUC })',
                    headers: { "Accept": "application/json; odata=verbose; charset=utf-8" },
                    beforeSend: function () {

                    },
                    success: function (res) {
                        var htmlLoaiVanBan = '';
                        htmlLoaiVanBan += '<option value ="">-- Toàn bộ --</option>';
                        $.each(res, function (key, item) {
                            htmlLoaiVanBan += '<option value ="' + item.ID + '">' + item.NAME + '</option>';
                        });
                        $("#linhVuc").append(htmlLoaiVanBan);
                    },
                });
            },
            loadData: function (isloading, refresh) {
                if (refresh) {
                    commonConfig.pageSize = 25;
                    commonConfig.pageNum = 1;
                    commonConfig.isClear = 0;
                    obj = {
                        pageNum: commonConfig.pageNum,
                        pageSize: commonConfig.pageSize
                    };
                }

                var skip = commonConfig.pageSize * (commonConfig.pageNum - 1);

                obj.SoKyHieu = "";
                obj.TrichYeu = "";
                obj.LoaiVanBan = "";
                obj.LinhVuc = "";
                obj.FromDate = "";
                obj.ToDate = "";

                var soKyHieu = $("#soKyHieu").val();
                if (soKyHieu != null && soKyHieu != "") {
                    obj.SoKyHieu = soKyHieu;
                }

                var trichYeu = $("#trichYeu").val();
                if (trichYeu != null && trichYeu != "") {
                    obj.TrichYeu = trichYeu;
                }

                var loaiVanBan = $("#loaiVanBan").val();
                if (loaiVanBan != null && loaiVanBan != "") {
                    var txtLoaiVanBan = $("#loaiVanBan option:selected").text();
                    obj.LoaiVanBan = txtLoaiVanBan;
                }

                var linhVuc = $("#linhVuc").val();
                if (linhVuc != null && linhVuc != "") {
                    var txtLinhVuc = $("#linhVuc option:selected").text();
                    obj.LinhVuc = txtLinhVuc;
                }

                var tuNgay = $("#tuNgay").val();
                if (tuNgay != null && tuNgay != "") {
                    obj.FromDate = tuNgay;
                }

                var denNgay = $("#denNgay").val();
                if (denNgay != null && denNgay != "") {
                    obj.ToDate = denNgay;
                }

                obj.Tag = 'THONGBAOPHOBIEN';

                $.ajax({
                    type: "POST",
                    data: obj,
                    url: '@Url.Action("GetDocumentByTag", "EOfficeDoc", new { area = "Modules" })',
                    beforeSend: function() {
                        if (isloading) {
                            loading.showLoading();
                        }
                    },
                    success: function (res) {
                        if (res.length > 0)
                        {
                            var totalRow = res[0].TOTALDOC;
                            var s = document.getElementById("soVanBan");
                            if(s)
                            s.innerHTML = "Tìm thấy " + totalRow + " văn bản";
                            var html = '';
                            var html1 = '';

                            $.each(res, function (key, item) {
                                var parts = item.NGAYBANHANH.split('/');

                                // Rearrange the parts to the desired format
                                var formattedDate = parts[1] + '/' + parts[0] + '/' + parts[2];

                                html += "<tr data-toggle='modal' data-target='#exampleModal' style='cursor: pointer;' onclick=\"show_detail('" + item.ID + "')\">"
									+ "<td style = 'width:20%'>" + item.SOKYHIEU + "</td>"
                                    + "<td>" + formattedDate + "</td>"
									+ "<td>" + item.TRICHYEU + "</td>"
									+ "</tr>";
                            });
                            main.pagingPage(totalRow, commonConfig.isClear, function () {
                                main.loadData(true, false);
                            });

                            $("#lstVanBanDetail").html(html);

                            var color = document.getElementById("color").value;
                            $('.pagination li.active a').css("background", color);
                        }
                        else {
                        main.pagingPage(0, commonConfig.isClear, function () {
                            main.loadData(true, false);
                        });

                        var html = '<tr><td colspan="3" style="text-align: center">Không tìm thấy dữ liệu</td></tr>'

                        $("#lstVanBanDetail").html(html);
                    }
                    if (isloading) {
                        loading.hideLoading();
                    }
                },

                });
        },
        pagingPage: function (totalRow, isClear, callback) {
            var totalPage = Math.ceil(totalRow / commonConfig.pageSize);
            if (totalPage >= 0 && commonConfig.isClear == 0) {
                if (totalPage == 0) {
                    totalPage = 1;
                }
                $('#paginationholder').html('<ul id="pagination" class="pagination"></ul>');
            }

            $("#paginationholder #pagination").twbsPagination({
                totalPages: totalPage,
                visiblePages: 6,
                first: "<<",
                next: ">",
                last: ">>",
                prev: "<",
                initiateStartPageClick: false,
                onPageClick: function (event, pageNum) {
                    commonConfig.pageNum = pageNum;
                    commonConfig.isClear = 1;
                    obj = {
                        pageNum: commonConfig.pageNum,
                        pageSize: commonConfig.pageSize,
                    };
                    setTimeout(callback, 200);
                }
            });
        }
        }

        $(document).ready(function () {
            var width = $("#slide_news .sp-slides-container").outerWidth();
            $(".sp-caption-container").css({ "width": width + "px" });
            if (showeOffice) {
                setTimeout(function () {
                    main.loadDocTypeList();
                    main.loadFieldList();
                    main.loadData(false, false);
                }, 500)
            }
        })
    </script>
}
