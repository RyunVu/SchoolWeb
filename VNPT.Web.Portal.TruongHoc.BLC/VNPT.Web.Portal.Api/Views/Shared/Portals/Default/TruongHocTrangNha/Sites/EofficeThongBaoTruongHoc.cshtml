                        </label>
                    </div>
                    <div class="col-md-8">
                        <input style="height: 34px; width: 100%; border: 1px solid #ccc;" id="soKyHieu" name="SoKyHieu" type="text" value="" />
                    </div>
                </div>
                <div class="col-md-12" style="padding-top: 5px;">
                    <div class="col-md-4" style="padding-top: 5px;">
                        <label class="label_van_ban_dieu_hanh">
                            Trích yếu:
                        </label>
                    </div>
                    <div class="col-md-8">
                        <input style="height: 34px; width: 100%; border: 1px solid #ccc;" id="trichYeu" name="TrichYeu" type="text" value="" />
                    </div>
                </div>
                <div class="col-md-12" style="padding-top: 5px;">
                    <div class="col-md-4" style="padding-top: 5px;">
