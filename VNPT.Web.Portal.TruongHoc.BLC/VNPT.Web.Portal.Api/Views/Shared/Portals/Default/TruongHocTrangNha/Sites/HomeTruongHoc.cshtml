@using VNPT.Core.Constants
@using VNPT.Web.Portal.Api.DTO
@using VNPT.Web.Portal.Api.Helper
@using VNPT.Web.Portal.Api.Models
@using VNPT.Web.Portal.Api.Code
@using VNPT.Web.Portal.Api.Providers
@using VNPT.Web.Portal.Base
@{
    Layout = ViewBag.Layout;
    var information = Session["PortalInformation"] as PortalInformation;
    var menus = MenuDal.MenuHome(information);
    var hotNews = menus.Any(m => m.MenuType == 1)
        ? NewsDal.GetHotNews(NewsCode.CHUYENMUC_TINTUC, 7, Session, Request)
        : new List<News>();

    var no = 1;
    var categories = new List<Tuple<string, string>>();
    foreach (var menu in menus.Where(m => m.MenuType == 2))
    {
        var names = (menu.Title ?? "").Split(';');
        var codes = (menu.Parameter ?? "").Split(';');
        for (var i = 0; i < Math.Min(names.Length, codes.Length); i++)
        {
            if (!string.IsNullOrWhiteSpace(codes[i]))
            {
                categories.Add(Tuple.Create(names[i].Trim(), codes[i].Trim()));
            }
        }
    }
    // Lấy trước tin của từng chuyên mục; chuyên mục chưa có bài thì không hiển thị
    var categoryNews = new Dictionary<string, List<News>>();
    foreach (var cat in categories)
    {
        if (!categoryNews.ContainsKey(cat.Item2))
        {
            categoryNews[cat.Item2] = cat.Item2.StartsWith("tin-tuc-tu-phong-gddt", StringComparison.OrdinalIgnoreCase)
                ? null
                : NewsDal.GetNews(cat.Item2, 4, 1, Session, Request);
        }
    }
    categories = categories.Where(c => categoryNews[c.Item2] == null || categoryNews[c.Item2].Any()).ToList();
}

@section MetaData {
    @Html.Action("Index", "Metadata", new { area = "Modules", Type = MetaDataType.Portal, Keywords = ViewBag.Tag, Title = ViewBag.Title, Description = ViewBag.Description })
}

@helper DateBlock(News item)
{
    <span class="tn-dateblock"><b>@item.CreateDate.ToString("dd")</b><small>Th @item.CreateDate.ToString("MM")</small></span>
}

@helper SectionTitle(string title, string href)
{
    <div class="tn-section-title">
        <h2>@if (string.IsNullOrEmpty(href)) { <span>@title</span> } else { <a href="@href">@title</a> }</h2>
    </div>
}

@if (hotNews.Any())
{
    var lead = hotNews.First();
    <section class="container tn-spotlight">
        @SectionTitle("Tiêu điểm", null)
        <article class="tn-lead">
            <a class="tn-lead-img" href="@Url.NewsLink(lead)" @ThemeHelper.Target(lead)>
                <img src="@Url.NewsImage(lead)" alt="@lead.Title" onerror="this.onerror=null;this.src='@ThemeHelper.NoImage'" />
            </a>
            <div class="tn-lead-body">
                <span class="tn-kicker">Tin mới nhất</span>
                <h3><a href="@Url.NewsLink(lead)" @ThemeHelper.Target(lead)>@lead.Title</a></h3>
                <p class="tn-lead-excerpt">@ThemeHelper.Excerpt(lead, 260)</p>
                <div class="tn-lead-foot">
                    <span class="tn-byline"><i class="fa fa-clock-o"></i> @ThemeHelper.ShortDate(lead)</span>
                    <a class="tn-readmore" href="@Url.NewsLink(lead)" @ThemeHelper.Target(lead)>Đọc tiếp <i class="fa fa-long-arrow-right"></i></a>
                </div>
            </div>
        </article>

        @if (hotNews.Count > 1)
        {
            <div class="tn-headlines">

                @foreach (var item in hotNews.Skip(1).Take(6))
                {
                    <article class="tn-headline">
                        <span class="tn-headline-no">@((no++).ToString("00"))</span>
                        <div>
                            <h4><a href="@Url.NewsLink(item)" @ThemeHelper.Target(item)>@item.Title</a></h4>
                            <span class="tn-byline">@ThemeHelper.ShortDate(item)</span>
                        </div>
                    </article>
                }
            </div>
        }
    </section>
}

<div class="container tn-body">
    <div class="row">
        <div class="col-md-8 col-md-push-4 body-page">
            @foreach (var systemMenu in menus.Where(m => m.MenuType == 3))
            {
                var slides = NewsDal.GetNews(systemMenu.Parameter, 12, 1, Session, Request);
                if (slides.Any())
                {
                    <section class="tn-block">
                        <div id="tn-slides" class="owl-carousel tn-slides">
                            @foreach (var item in slides)
                            {
                                var href = !string.IsNullOrWhiteSpace(item.Description) ? item.Description : Url.NewsLink(item);
                                <figure class="tn-slide">
                                    <a href="@href"><img src="@Url.NewsImage(item)" alt="@item.Title" /></a>
                                    @if (!string.IsNullOrWhiteSpace(item.Title))
                                    {
                                        <figcaption>@item.Title</figcaption>
                                    }
                                </figure>
                            }
                        </div>
                    </section>
                }
            }

            @foreach (var cat in categories)
            {
                var listUrl = Url.Site("danh-sach-tin-tuc", parameter: new { param = cat.Item2 }).ToString();
                <section class="tn-block tn-cat">
                    @SectionTitle(SystemParameterDto.Translate(cat.Item1), listUrl)
                    @if (cat.Item2.StartsWith("tin-tuc-tu-phong-gddt", StringComparison.OrdinalIgnoreCase))
                    {
                        <div class="tn-cat-legacy">
                            @Html.Action("StyleHaft", "CongDoan", new { area = "Modules", Code = cat.Item2, number = 4 })
                        </div>
                    }
                    else
                    {
                        var items = categoryNews[cat.Item2];
                        if (!items.Any())
                        {
                            <p class="tn-empty">Chưa có bài viết trong chuyên mục này.</p>
                        }
                        else
                        {
                            var first = items.First();
                            <div class="tn-cat-body">
                                <article class="tn-cat-lead">
                                    <a class="tn-cat-img" href="@Url.NewsLink(first)" @ThemeHelper.Target(first)>
                                        <img src="@Url.NewsImage(first)" alt="@first.Title" loading="lazy" onerror="this.onerror=null;this.src='@ThemeHelper.NoImage'" />
                                    </a>
                                    <h3><a href="@Url.NewsLink(first)" @ThemeHelper.Target(first)>@first.Title</a></h3>
                                    <span class="tn-byline"><i class="fa fa-clock-o"></i> @ThemeHelper.ShortDate(first)</span>
                                    <p>@ThemeHelper.Excerpt(first, 150)</p>
                                </article>
                                <ul class="tn-timeline">
                                    @foreach (var item in items.Skip(1))
                                    {
                                        <li>
                                            @DateBlock(item)
                                            <a href="@Url.NewsLink(item)" @ThemeHelper.Target(item)>@item.Title</a>
                                        </li>
                                    }
                                    <li class="tn-timeline-more"><a href="@listUrl">Xem toàn bộ chuyên mục <i class="fa fa-angle-double-right"></i></a></li>
                                </ul>
                            </div>
                        }
                    }
                </section>
            }

            @foreach (var systemMenu in menus.Where(m => m.MenuType == 4 || m.MenuType == 5).OrderBy(m => m.SortNo))
            {
                if (systemMenu.MenuType == 4)
                {
                    var media = NewsDal.GetNews(systemMenu.Parameter, 5, 1, Session, Request);
                    if (media.Any())
                    {
                        <section class="tn-block">
                            @SectionTitle(SystemParameterDto.Translate(systemMenu.Title), Url.Site("danh-sach-tin-tuc", parameter: new { param = systemMenu.Parameter }).ToString())
                            <div class="tn-gallery">
                                @foreach (var item in media)
                                {
                                    <figure class="tn-gallery-item">
                                        <a href="@Url.NewsLink(item)"><img src="@Url.NewsImage(item)" alt="@item.Title" loading="lazy" onerror="this.onerror=null;this.src='@ThemeHelper.NoImage'" /></a>
                                        <a class="tn-gallery-zoom" href="@Url.NewsImage(item)" title="@item.Title" aria-label="Phóng to"><i class="fa fa-expand"></i></a>
                                        <figcaption><a href="@Url.NewsLink(item)">@item.Title</a></figcaption>
                                    </figure>
                                }
                            </div>
                        </section>
                    }
                }
                else
                {
                    <section class="tn-block tn-banner">
                        <a target="_blank" rel="noopener" href="@systemMenu.Action"><img src="@Url.Image(systemMenu.Description)" alt="@systemMenu.Title" /></a>
                    </section>
                }
            }
        </div>
        <div class="col-md-4 col-md-pull-8 sidebar-mobile-ontop">
            @Html.Partial("~/Views/Shared/Portals/Layouts/TruongHocTrangNha/_Sidebar.cshtml")
        </div>
    </div>
</div>

@section scripts {
    <script type="text/javascript">
        $(function () {
            var $slides = $("#tn-slides");
            if ($slides.find(".tn-slide").length) {
                $slides.owlCarousel({
                    items: 1, loop: $slides.find(".tn-slide").length > 1, autoplay: true, autoplayTimeout: 5000,
                    autoplayHoverPause: true, dots: true, nav: true,
                    navText: ['<i class="fa fa-angle-left"></i>', '<i class="fa fa-angle-right"></i>']
                });
            }
        });
    </script>
}
