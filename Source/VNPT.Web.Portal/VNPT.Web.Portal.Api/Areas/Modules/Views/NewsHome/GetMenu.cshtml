@using VNPT.Web.Portal.Base
@using VNPT.Web.Portal.Api.Models;
@using VNPT.Web.Portal.Api.Helper

@model List<MenuModel>

@foreach (var menu in Model)
{
	if (menu.Children.Count() > 0)
	{
		<li class="li-submenu">
			<a>@menu.Title <i class="@(menu.Icon != null ? "fa fa-angle-down" : "")fa fa-angle-down"></i></a>
			@if (menu.Children.Count() > 0)
			{
				<ul class="sub-menu">
					@foreach (var sub in menu.Children)
					{
						<li class="li-submenu2">
							@if (sub.Action.CheckUrl())
							{
								<a target="_blank" href="@sub.Action" title="">
									@sub.Title
								</a>
							}
							else
							{
								if (sub.Children.Count() > 0)
								{
									<a>
										<i class="fa fa-caret-right"></i>
										@sub.Title
										<i class="fa fa-angle-down"></i>
									</a>
									<ul class="sub-menu2">
										@foreach (var sub2 in sub.Children)
										{
											<li>
												@if (sub2.Action.CheckUrl())
												{
													<a target="_blank" href="@sub2.Action" title="">
														@sub2.Title
													</a>
												}
												else
												{
													<a href="@(sub2.Parameter != null && sub2.Parameter != "" ? Url.Site(sub2.Action , parameter: new { param = sub2.Parameter }).ToString() : Url.Site(sub2.Action).ToString() )" title="">
														<i class="fa fa-caret-right"></i>
														@sub2.Title
													</a>
												}
											</li>
										}
									</ul>
								}
								else
								{
									<a href="@(sub.Parameter != null && sub.Parameter != "" ? Url.Site(sub.Action , parameter: new { param = sub.Parameter }).ToString() : Url.Site(sub.Action).ToString() )" title="">
										<i class="fa fa-caret-right"></i>
										@sub.Title
									</a>
								}
							}
						</li>
					}
				</ul>
			}
		</li>
	}
	else
	{
		<li>
			@if (menu.Action.CheckUrl())
			{
				<a target="_blank" href="@menu.Action" title="">
					@menu.Title
				</a>
			}
			else
			{
				<a href="@(menu.Parameter != null && menu.Parameter != "" ? Url.Site(menu.Action , parameter: new { param = menu.Parameter }).ToString() : Url.Site(menu.Action).ToString())" title="">
					@menu.Title
				</a>
			}
		</li>
	}
}