@section scripts {
	<script type="text/javascript">

		var data;

		var nameCongThongTin = document.getElementById("nameCongThongTin").value;
        var nameUBNDXA = document.getElementById("nameUBNDXA").value;

		function show_detail(id) {
			var lengtArr = data.length;
			for (let i = 0; i < lengtArr; i++) {
				const item = data[i];
				if (item.Id == id) {
					var SO_KY_HIEU = '';
					if (item.SốKýHiệu != null) {
						SO_KY_HIEU = item.SốKýHiệu;
					}

					var NGAY_BAN_HANH_FORMAT = '';
					if (item.NgàyBanHành != null) {
						var number = item.NgàyBanHành.match(/\d+/)[0];
						var NGAY_BAN_HANH = new Date(+number);
						NGAY_BAN_HANH_FORMAT = NGAY_BAN_HANH.toLocaleDateString('en-US', { day: '2-digit', month: '2-digit', year: 'numeric' });
					}

					var NGUOI_KY = '';
					if (item.NgườiKý != null) {
						NGUOI_KY = item.NgườiKý;
					}

					var TRICH_YEU = '';
					if (item.TríchYếu != null) {
						TRICH_YEU = item.TríchYếu;
					}

					var CO_QUAN_BAN_HANH = '';
					if (item.CơQuanBanHànhValue != null) {
						CO_QUAN_BAN_HANH = item.CơQuanBanHànhValue;
					}

					var LOAI_VAN_BAN = '';
					if (item.LoạiVănBảnValue != null) {
						LOAI_VAN_BAN = item.LoạiVănBảnValue;
					}

					var LINH_VUC = '';
					if (item.LĩnhVựcValue != null) {
						LINH_VUC = item.LĩnhVựcValue;
					}

					var CONG_BAO_SO = '';
					if (item.CôngBáoSố != null) {
						CONG_BAO_SO = item.CôngBáoSố;
					}

					var NGAY_CONG_BAO_FORMAT = '';
					if (item.NgàyPhátHànhCôngBáo != null) {
						var number = item.NgàyPhátHànhCôngBáo.match(/\d+/)[0];
						var NGAY_CONG_BAO = new Date(+number);
						NGAY_CONG_BAO_FORMAT = NGAY_CONG_BAO.toLocaleDateString('en-US', { day: '2-digit', month: '2-digit', year: 'numeric' });
					}

					var HIEU_LUC = '';
					if (item.HiệuLựcValue != null) {
						HIEU_LUC = item.HiệuLựcValue;
					}

					var GHI_CHU = '';
					if (item.GhiChú != null) {
						GHI_CHU = item.GhiChú;
					}

					$.ajax({
						type: "GET",
						//data: obj,
						url: "https://lamdong.gov.vn/sites/" + nameCongThongTin + "/_api/web/lists/getByTitle('Qu%E1%BA%A3n%20l%C3%BD%20v%C4%83n%20b%E1%BA%A3n')/items(" + id + ")?$expand=AttachmentFiles",
						headers: { "Accept": "application/json; odata=verbose; charset=utf-8" },
						beforeSend: function () {

						},
						success: function (res) {
							var attachmentFile = "";
							var lengthAttach = res.d.AttachmentFiles.results.length;
							if (lengthAttach > 0) {
								for (let i = 0; i < lengthAttach; i++) {
									const itemAttach = res.d.AttachmentFiles.results[i];
									attachmentFile += '<div><a target="_blank" href="https://lamdong.gov.vn/' + itemAttach.ServerRelativeUrl + '">' + itemAttach.FileName + '</a></div>'
								}
							}

							var html = '<div class="content_row">'
								+ '<div class="col-md-12 detail_van_ban_dieu_hanh"><div class="col-md-4"><label>Số/Ký hiệu</label></div><div class="col-md-8"><label>' + SO_KY_HIEU + '</label></div></div>'
								+ '<div class="col-md-12 detail_van_ban_dieu_hanh"><div class="col-md-4"><label>Ngày ban hành</label></div><div class="col-md-8"><label>' + NGAY_BAN_HANH_FORMAT + '</label></div></div>'
								+ '<div class="col-md-12 detail_van_ban_dieu_hanh"><div class="col-md-4"><label>Người ký</label></div><div class="col-md-8"><label>' + NGUOI_KY + '</label></div></div>'
								+ '<div class="col-md-12 detail_van_ban_dieu_hanh"><div class="col-md-4"><label>Trích yếu</label></div><div class="col-md-8"><label>' + TRICH_YEU + '</label></div></div>'
								+ '<div class="col-md-12 detail_van_ban_dieu_hanh"><div class="col-md-4"><label>Cơ quan ban hành</label></div><div class="col-md-8"><label>' + CO_QUAN_BAN_HANH + '</label></div></div>'
								+ '<div class="col-md-12 detail_van_ban_dieu_hanh"><div class="col-md-4"><label>Loại văn bản</label></div><div class="col-md-8"><label>' + LOAI_VAN_BAN + '</label></div></div>'
								+ '<div class="col-md-12 detail_van_ban_dieu_hanh"><div class="col-md-4"><label>Lĩnh Vực</label></div><div class="col-md-8"><label>' + LINH_VUC + '</label></div></div>'
								+ '<div class="col-md-12 detail_van_ban_dieu_hanh"><div class="col-md-4"><label>Công báo số</label></div><div class="col-md-8"><label>' + CONG_BAO_SO + '</label></div></div>'
								+ '<div class="col-md-12 detail_van_ban_dieu_hanh"><div class="col-md-4"><label>Ngày phát hành công báo</label></div><div class="col-md-8"><label>' + NGAY_CONG_BAO_FORMAT + '</label></div></div>'
								+ '<div class="col-md-12 detail_van_ban_dieu_hanh"><div class="col-md-4"><label>Hiệu lực</label></div><div class="col-md-8"><label>' + HIEU_LUC + '</label></div></div>'
								+ '<div class="col-md-12 detail_van_ban_dieu_hanh"><div class="col-md-4"><label>Ghi chú</label></div><div class="col-md-8"><label>' + GHI_CHU + '</label></div></div>'
								+ '<div class="col-md-12 detail_van_ban_dieu_hanh"><div class="col-md-4"><label>Đính kèm</label></div><div class="col-md-8"><label>' + attachmentFile + '</label></div></div>'
								+ '</div>';
							$("#vanBanDetail").html(html);

							var href = 'https://lamdong.gov.vn/sites/' + nameCongThongTin + '/SitePages/chi-tiet-van-ban.aspx?$id=' + id + '&$url=https://lamdong.gov.vn/sites/' + nameCongThongTin + '&$docName=Qu%E1%BA%A3n%20l%C3%BD%20v%C4%83n%20b%E1%BA%A3n';

