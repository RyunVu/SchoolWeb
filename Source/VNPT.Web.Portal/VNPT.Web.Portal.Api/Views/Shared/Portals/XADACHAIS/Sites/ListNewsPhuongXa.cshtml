<script src="~/Scripts/jquery.twbsPagination.min.js"></script>

@section scripts {
	<script type="text/javascript">

		var data;

		var nameCongThongTin = document.getElementById("nameCongThongTin").value;

		function show_detail(id) {
			var lengtArr = data.length;
			for (let i = 0; i < lengtArr; i++) {
				const item = data[i];
				if (item.Id == id) {
					var SO_KY_HIEU = '';
					if (item.SốKýHiệu != null) {
						SO_KY_HIEU = item.SốKýHiệu;
					}

					var NGAY_BAN_HANH_FORMAT = '';
					if (item.NgàyBanHành != null) {
						var number = item.NgàyBanHành.match(/\d+/)[0];
						var NGAY_BAN_HANH = new Date(+number);
						NGAY_BAN_HANH_FORMAT = NGAY_BAN_HANH.toLocaleDateString('en-US', { day: '2-digit', month: '2-digit', year: 'numeric' });
					}

					var NGUOI_KY = '';
					if (item.NgườiKý != null) {
						NGUOI_KY = item.NgườiKý;
					}

					var TRICH_YEU = '';
					if (item.TríchYếu != null) {
						TRICH_YEU = item.TríchYếu;
					}

					var CO_QUAN_BAN_HANH = '';
					if (item.CơQuanBanHànhValue != null) {
						CO_QUAN_BAN_HANH = item.CơQuanBanHànhValue;
					}

					var LOAI_VAN_BAN = '';
					if (item.LoạiVănBảnValue != null) {
						LOAI_VAN_BAN = item.LoạiVănBảnValue;
					}

					var LINH_VUC = '';
					if (item.LĩnhVựcValue != null) {
						LINH_VUC = item.LĩnhVựcValue;
					}

					var CONG_BAO_SO = '';
					if (item.CôngBáoSố != null) {
						CONG_BAO_SO = item.CôngBáoSố;
					}

					var NGAY_CONG_BAO_FORMAT = '';
					if (item.NgàyPhátHànhCôngBáo != null) {
						var number = item.NgàyPhátHànhCôngBáo.match(/\d+/)[0];
						var NGAY_CONG_BAO = new Date(+number);
						NGAY_CONG_BAO_FORMAT = NGAY_CONG_BAO.toLocaleDateString('en-US', { day: '2-digit', month: '2-digit', year: 'numeric' });
					}

					var HIEU_LUC = '';
					if (item.HiệuLựcValue != null) {
						HIEU_LUC = item.HiệuLựcValue;
					}

					var GHI_CHU = '';
					if (item.GhiChú != null) {
						GHI_CHU = item.GhiChú;
					}

					$.ajax({
						type: "GET",
						//data: obj,
						url: "https://lamdong.gov.vn/sites/" + nameCongThongTin + "/_api/web/lists/getByTitle('Qu%E1%BA%A3n%20l%C3%BD%20v%C4%83n%20b%E1%BA%A3n')/items(" + id + ")?$expand=AttachmentFiles",
						headers: { "Accept": "application/json; odata=verbose; charset=utf-8" },
						beforeSend: function () {

						},
						success: function (res) {
							var attachmentFile = "";
							var lengthAttach = res.d.AttachmentFiles.results.length;
							if (lengthAttach > 0) {
								for (let i = 0; i < lengthAttach; i++) {
									const itemAttach = res.d.AttachmentFiles.results[i];
									attachmentFile += '<div><a target="_blank" href="https://lamdong.gov.vn/' + itemAttach.ServerRelativeUrl + '">' + itemAttach.FileName + '</a></div>'
								}
							}

							var html = '<div class="content_row">'
								+ '<div class="col-md-12 detail_van_ban_dieu_hanh"><div class="col-md-4"><label>Số/Ký hiệu</label></div><div class="col-md-8"><label>' + SO_KY_HIEU + '</label></div></div>'
								+ '<div class="col-md-12 detail_van_ban_dieu_hanh"><div class="col-md-4"><label>Ngày ban hành</label></div><div class="col-md-8"><label>' + NGAY_BAN_HANH_FORMAT + '</label></div></div>'
								+ '<div class="col-md-12 detail_van_ban_dieu_hanh"><div class="col-md-4"><label>Người ký</label></div><div class="col-md-8"><label>' + NGUOI_KY + '</label></div></div>'
								+ '<div class="col-md-12 detail_van_ban_dieu_hanh"><div class="col-md-4"><label>Trích yếu</label></div><div class="col-md-8"><label>' + TRICH_YEU + '</label></div></div>'
								+ '<div class="col-md-12 detail_van_ban_dieu_hanh"><div class="col-md-4"><label>Cơ quan ban hành</label></div><div class="col-md-8"><label>' + CO_QUAN_BAN_HANH + '</label></div></div>'
								+ '<div class="col-md-12 detail_van_ban_dieu_hanh"><div class="col-md-4"><label>Loại văn bản</label></div><div class="col-md-8"><label>' + LOAI_VAN_BAN + '</label></div></div>'
								+ '<div class="col-md-12 detail_van_ban_dieu_hanh"><div class="col-md-4"><label>Lĩnh Vực</label></div><div class="col-md-8"><label>' + LINH_VUC + '</label></div></div>'
								+ '<div class="col-md-12 detail_van_ban_dieu_hanh"><div class="col-md-4"><label>Công báo số</label></div><div class="col-md-8"><label>' + CONG_BAO_SO + '</label></div></div>'
								+ '<div class="col-md-12 detail_van_ban_dieu_hanh"><div class="col-md-4"><label>Ngày phát hành công báo</label></div><div class="col-md-8"><label>' + NGAY_CONG_BAO_FORMAT + '</label></div></div>'
								+ '<div class="col-md-12 detail_van_ban_dieu_hanh"><div class="col-md-4"><label>Hiệu lực</label></div><div class="col-md-8"><label>' + HIEU_LUC + '</label></div></div>'
								+ '<div class="col-md-12 detail_van_ban_dieu_hanh"><div class="col-md-4"><label>Ghi chú</label></div><div class="col-md-8"><label>' + GHI_CHU + '</label></div></div>'
								+ '<div class="col-md-12 detail_van_ban_dieu_hanh"><div class="col-md-4"><label>Đính kèm</label></div><div class="col-md-8"><label>' + attachmentFile + '</label></div></div>'
								+ '</div>';
							$("#vanBanDetail").html(html);

							var href = 'https://lamdong.gov.vn/sites/' + nameCongThongTin + '/SitePages/chi-tiet-van-ban.aspx?$id=' + id + '&$url=https://lamdong.gov.vn/sites/' + nameCongThongTin + '&$docName=Qu%E1%BA%A3n%20l%C3%BD%20v%C4%83n%20b%E1%BA%A3n';

							//$("#vanBanDetailDuongDan").html('<a target="_blank" class="btn btn-primary" href="' + href + '">Đường dẫn</a>');
							var a = document.getElementById('duongDan'); //or grab it by tagname etc
							a.href = href;
						},
					});

					return;
				}
			}
		}

		function parseNestedXml(element, obj) {
			for (let i = 0; i < element.children.length; i++) {
				const child = element.children[i];
				obj[child.nodeName] = {};

				// Iterate through the child's attributes
				for (let j = 0; j < child.attributes.length; j++) {
					const attribute = child.attributes[j];
					obj[child.nodeName][attribute.nodeName] = attribute.nodeValue;
				}

				// Recursively iterate through the child's children
				if (child.children.length > 0) {
					obj[child.nodeName] = parseNestedXml(child, obj[child.nodeName]);
				} else {
					obj[child.nodeName]["#text"] = child.textContent;
				}
			}

			return obj;
		}

		var commonConfig_VBDieuHanh = {
			pageSize: 25,
			pageNum: 1,
			isClear: 0,
			type: ""
		}

		var skip = commonConfig_VBDieuHanh.pageSize * (commonConfig_VBDieuHanh.pageNum - 1);

		var obj = {
			SourceUrl: "https://lamdong.gov.vn/sites/" + nameCongThongTin + "/_vti_bin/listdata.svc/QuảnLýVănBản/?&$inlinecount=allpages&$skip=" + skip + "&$top=25&$orderby=NgàyBanHành desc&$filter="
		}

		var mainVBLienQuan = {
			loadDataGeneral: function () {
				$.ajax({
					type: "GET",
					//data: obj,
					url: "https://lamdong.gov.vn/sites/" + nameCongThongTin + "/_api/web/lists/getByTitle('Qu%E1%BA%A3n%20l%C3%BD%20v%C4%83n%20b%E1%BA%A3n')/fields?$select=Title,Choices&$filter=Hidden%20eq%20false%20and%20CanBeDeleted%20eq%20true",
					headers: { "Accept": "application/json; odata=verbose; charset=utf-8" },
					beforeSend: function () {

					},
					success: function (res) {
						var items = res.d.results;

						var lengtArr = items.length;

						var htmlLoaiVanBan = '';
						var htmlCoQuanBanHanh = '';
						var htmlLinhVuc = '';

						for (let i = 0; i < lengtArr; i++) {
							const item = items[i];
							if (item.Title === "Loại văn bản") {
								htmlLoaiVanBan += '<option value ="">-- Toàn bộ --</option>';
								for (let j = 0; j < item.Choices.results.length; j++) {
									const element = item.Choices.results[j];
									htmlLoaiVanBan += '<option value ="' + element + '"> ' + element + '</option>';
								}
							} else if (item.Title == "Cơ quan ban hành") {
								htmlCoQuanBanHanh += '<option value ="">-- Toàn bộ --</option>';
								for (let j = 0; j < item.Choices.results.length; j++) {
									const element = item.Choices.results[j];
									htmlCoQuanBanHanh += '<option value ="' + element + '"> ' + element + '</option>';
								}
							} else if (item.Title == "Lĩnh Vực") {
								//htmlLinhVuc += '<option value ="">-- Toàn bộ --</option>';
								for (let j = 0; j < item.Choices.results.length; j++) {
									const element = item.Choices.results[j];
									if (element.includes("Quy hoạch")) {
										if (element == "Quy hoạch") {
											htmlLinhVuc += '<option selected="selected" value ="' + element + '"> ' + element + '</option>';
										}
										else {
											htmlLinhVuc += '<option value ="' + element + '"> ' + element + '</option>';
										}
									}
								}
							}
						}

						$("#loaiVanBan").append(htmlLoaiVanBan);
						$("#coQuanBanHanh").append(htmlCoQuanBanHanh);
						$("#linhVuc").append(htmlLinhVuc);
					},
				});
			},
			loadData: function (isloading, refresh) {
				if (refresh) {
					commonConfig_VBDieuHanh.pageSize = 25;
					commonConfig_VBDieuHanh.pageNum = 1;
					commonConfig_VBDieuHanh.isClear = 0;
				}

				var skip = commonConfig_VBDieuHanh.pageSize * (commonConfig_VBDieuHanh.pageNum - 1);

				obj.SourceUrl = "https://lamdong.gov.vn/sites/" + nameCongThongTin + "/_vti_bin/listdata.svc/QuảnLýVănBản/?&$inlinecount=allpages&$skip=" + skip + "&$top=25&$orderby=NgàyBanHành desc&$filter=";

				var filter = "";

				var soKyHieu = $("#soKyHieu").val();
				if (soKyHieu != null && soKyHieu != "") {
					if (filter != "") {
						filter += " and ";
					}
					filter += "substringof('" + soKyHieu.toLowerCase() + "',tolower(SốKýHiệu)) eq true";
				}

				var trichYeu = $("#trichYeu").val();
				if (trichYeu != null && trichYeu != "") {
					if (filter != "") {
						filter += " and ";
					}
					filter += "substringof('" + trichYeu.toLowerCase() + "',tolower(TríchYếu)) eq true";
				}

				var loaiVanBan = $("#loaiVanBan").val();
				if (loaiVanBan != null && loaiVanBan != "") {
					if (filter != "") {
						filter += " and ";
					}
					filter += "LoạiVănBảnValue eq '" + loaiVanBan + "'";
				}

				var coQuanBanHanh = $("#coQuanBanHanh").val();
				if (coQuanBanHanh != null && coQuanBanHanh != "") {
					if (filter != "") {
						filter += " and ";
					}
					filter += "CơQuanBanHànhValue eq '" + coQuanBanHanh + "'";
				}

				var linhVuc = $("#linhVuc").val();

				if (linhVuc == null || linhVuc == "") {
					linhVuc = "Quy hoạch";
				}

				if (linhVuc != null && linhVuc != "") {
					if (filter != "") {
						filter += " and ";
					}
					filter += "LĩnhVựcValue eq '" + linhVuc + "'";
				}

				var tuNgay = $("#tuNgay").val();
				if (tuNgay != null && tuNgay != "") {
					if (filter != "") {
						filter += " and ";
					}
					filter += "NgàyBanHành ge datetime'" + tuNgay + "'";
				}

				var denNgay = $("#denNgay").val();
				if (denNgay != null && denNgay != "") {
					if (filter != "") {
						filter += " and ";
					}
					filter += "NgàyBanHành le datetime'" + denNgay + "'";
				}

				obj.SourceUrl += filter;

				// and substringof('123',tolower(SốKýHiệu)) eq true and (substringof('345',tolower(TríchYếu)) eq true)
				// LĩnhVựcValue eq 'Tuyển dụng CBCCVC' and CơQuanBanHànhValue eq 'UBND huyện Cát Tiên' and LoạiVănBảnValue eq 'Báo cáo'
				// and NgàyBanHành ge datetime'2023-01-03' and NgàyBanHành le datetime'2023-01-04'

				$.ajax({
					type: "POST",
					data: obj,
					url: "https://api.lamdong.gov.vn/RestApi/Readjson",
					beforeSend: function () {
						if (isloading) {
							loading.showLoading();
						}
					},
					success: function (res) {
						if (res != "The remote server returned an error: (400) Bad Request." && res.d.results.length > 0) {
							data = res.d.results;
							var totalRow = res.d.__count;
							var s = document.getElementById("soVanBan");
							s.innerHTML = "Tìm thấy " + totalRow + " văn bản";
							var html = '';
							var html1 = '';
							$.each(res.d.results, function (key, item) {
								var number = item.NgàyBanHành.match(/\d+/)[0];
								var NGAY_BAN_HANH = new Date(+number);
								var NGAY_BAN_HANH_FORMAT = NGAY_BAN_HANH.toLocaleDateString('en-US', { day: '2-digit', month: '2-digit', year: 'numeric' });

								html += '<tr data-toggle="modal" data-target="#exampleModal" style="cursor: pointer;" onclick="show_detail(' + item.Id + ')">'
									+ '<td style = "width:20%">' + item.SốKýHiệu + '</td>'
									+ '<td>' + NGAY_BAN_HANH_FORMAT + '</td>'
									+ '<td>' + item.TríchYếu + '</td>'
									+ '</tr>';
                            });

							mainVBLienQuan.pagingPage(totalRow, commonConfig_VBDieuHanh.isClear, function () {
								mainVBLienQuan.loadData(true, false);
							});

							$("#lstVanBanDetail").html(html);

							var color = document.getElementById("color").value;
							$('.pagination li.active a').css("background", color);
						}
						else {
							mainVBLienQuan.pagingPage(0, commonConfig_VBDieuHanh.isClear, function () {
								mainVBLienQuan.loadData(true, false);
							});

							var html = '<tr><td colspan="3" style="text-align: center">Không tìm thấy dữ liệu</td></tr>'

							$("#lstVanBanDetail").html(html);
						}
						if (isloading) {
							loading.hideLoading();
						}
					},

				});
			},
			pagingPage: function (totalRow, isClear, callback) {
				var totalPage = Math.ceil(totalRow / commonConfig_VBDieuHanh.pageSize);
				if (totalPage >= 0 && commonConfig_VBDieuHanh.isClear == 0) {
					if (totalPage == 0) {
						totalPage = 1;
					}
					$('#paginationholder_VBDieuHanh').html('<ul id="pagination_VBDieuHanh" class="pagination"></ul>');
				}

				$("#paginationholder_VBDieuHanh #pagination_VBDieuHanh").twbsPagination({

					totalPages: totalPage,
					visiblePages: 6,
					first: "<<",
					next: ">",
					last: ">>",
					prev: "<",
					initiateStartPageClick: false,
					onPageClick: function (event, page) {
						commonConfig_VBDieuHanh.pageNum = page;
						commonConfig_VBDieuHanh.isClear = 1;
						setTimeout(callback, 200);
					}
				});
			}
		}

		///////////////////////////////////////////////

        function getUrlParameter(sParam) {
            var sPageURL = decodeURIComponent(window.location.search.substring(1)),
                sURLVariables = sPageURL.split('&'),
                sParameterName,
                i;

            for (i = 0; i < sURLVariables.length; i++) {
                sParameterName = sURLVariables[i].split('=');

                if (sParameterName[0] === sParam) {
                    return sParameterName[1] === undefined ? true : sParameterName[1];
                }
            }
        }

        function formatDateString(string) {
            var d = new Date(string);
            return (d.getDate() < 9 ? ("0" + d.getDate()) : d.getDate()) + "/" + ((d.getMonth() + 1) < 9 ? ("0" + (d.getMonth() + 1)) : (d.getMonth() + 1)) + "/" + d.getFullYear();
        }
        function CutString(number, stringContent) {
            var content = $(stringContent).text();
            var c = content.substr(0, number);
            return c;
        }
        function CutStringNoHtml(number, stringContent) {
            var content = stringContent.substr(0, number);
            return content;
        }

        var commonConfig = {
            pageSize: 10,
            page: 1,
            number: 100000,
            isClear: 0,
        }

        var Code = '@code';
        var linkImg = '@linkImg';
        var url_api = '';
        if (Code == "CM_TINTUYENTRUYEN".toLowerCase()) {
            url_api = '@Url.Action("GetNewsList2", "CongDoan", new { area = "Modules", type = 2 })';
        }else{
            url_api = '@Url.Action("GetNewsList2", "CongDoan", new { area = "Modules", type = 1 })';
        }

        var obj = {
            page: commonConfig.page,
            pageSize: commonConfig.pageSize,
            keyword: $("#keyword").val(),
            Code: Code,
            number: commonConfig.number
        };

        var main = {
            loadData: function () {
                $.ajax({
                    type: "POST",
                    data: obj,
                    url: url_api,
                    beforeSend: function () {
                        loading.showLoading();
                    },
                    success: function (res) {
                        if (res.length > 0) {
                            var html = '';
                            var text = '';
                            $.each(res, function (key, item) {
                                var content = "";
                                if (item.SHORT_CONTENT != null) {
                                    content = item.SHORT_CONTENT;
                                } else {
                                    content = CutString(250,item.CONTENT);
                                }

                                if (item.URL_IMG != null) {
                                    html += '<div class="box-news-cate">'
                                            + '<a class="img" href="@Url.Site("chi-tiet-tin-tuc", parameter: new { param = "" })" data-href="' + item.ALIAS + '"  title="' + item.TITLE + '" >'
                                            + '<img src="' + config.UrlImage(item.URL_IMG) + '" alt="' + item.TITLE + '" >'
                                            + '</a>'
                                            + '<div class="title">'
                                                + '<h3><a href="@Url.Site("chi-tiet-tin-tuc", parameter: new { param = "" })" data-href="' + item.ALIAS + '" title="' + item.TITLE + '">' + item.TITLE + '</a></h3>'
                                                + '<span class="time-primary"><i class="fa fa-clock-o"></i>' + item.CREATE + '</span>'
                                                + '<span class="desc-primary" > ' + content + ' </span>'
                                            + '</div>'
                                       + '</div>';
                                } else {
                                    html += '<div class="box-news-cate">'
                                            + '<a class="img" href="@Url.Site("chi-tiet-tin-tuc", parameter: new { param = "" })" data-href="' + item.ALIAS + '"  title="' + item.TITLE + '" >'
										+ '<img src="/Images/noimage.png" alt="' + item.TITLE + '" >'
                                            + '</a>'
                                            + '<div class="title">'
                                                + '<h3><a href="@Url.Site("chi-tiet-tin-tuc", parameter: new { param = "" })" data-href="' + item.ALIAS + '" title="' + item.TITLE + '">' + item.TITLE + '</a></h3>'
                                                + '<span class="time-primary"><i class="fa fa-clock-o"></i>' + item.CREATE + '</span>'
                                                + '<span class="desc-primary" > ' + content + ' </span>'
                                            + '</div>'
                                       + '</div>';
                                }

                            });

                            main.pagingPage(res[0].TOTALPAGE, commonConfig.isClear, function () {
                                main.loadData();
                            });

                            $("#lstVanBanPl").html(html);

                            $("#lstVanBanPl").find("a").each(function () {
                                var href = $(this).attr("href"), data = $(this).attr("data-href");
                                if (data != undefined) {
                                    $(this).attr("href", href + data);
                                }
                            });

                        } else {
                            var parentHtml = '<div class="table-text-system table-responsive ">'
                                + '<h4> không tìm thấy dữ liệu</h4>'
                            + '</div>';
                            main.pagingPage(0, commonConfig.isClear, function () {
                                main.loadData();
                            });
                            $("#lstVanBanPl").html(parentHtml);
                        }
                        loading.hideLoading();
                    }
                });
            },
            pagingPage: function (totalRow,isClear, callback) {
                var totalPage = Math.ceil(totalRow / commonConfig.pageSize);
                if (totalPage >= 0 && commonConfig.isClear == 0) {
                    if (totalPage == 0) {
                        totalPage = 1;
                    }
                    $('#paginationholder').html('<ul id="pagination" class="pagination"></ul>');

                }

                $("#paginationholder #pagination").twbsPagination({

                    totalPages: totalPage,
                    visiblePages: 6,
                    first: "<<",
                    next: ">",
                    last: ">>",
                    prev: "<",
                    initiateStartPageClick: false,
                    onPageClick: function (event, page) {
                        commonConfig.page = page;
                        commonConfig.isClear = 1
                        obj = {
                            page: commonConfig.page,
                            pageSize: commonConfig.pageSize,
                            keyword: $("#keyword").val(),
                            number: commonConfig.number,
                            Code: Code
                        };
                        setTimeout(callback, 200);
                    }
                });
            }
        }

        $(document).ready(function () {
            main.loadData();

			setTimeout(function () {
				mainVBLienQuan.loadDataGeneral();
				mainVBLienQuan.loadData(false, false);
			}, 500);
        });

        $("#keyword").blur(function () {
            loading.showLoading();
            obj = {
                page: commonConfig.page,
                pageSize: commonConfig.pageSize,
                keyword: $("#keyword").val(),
                number: commonConfig.number,
                Code: Code
            };
            commonConfig.isClear = 0;
            main.loadData();
        });

        $(document).keypress(function (e) {
            if (e.which == 13) {
                obj = {
                    page: commonConfig.page,
                    pageSize: commonConfig.pageSize,
                    keyword: $("#keyword").val(),
                    number: commonConfig.number,
                    Code: Code
                };
                commonConfig.isClear = 0;
                main.loadData();
            }
        });

        $("#keyword").keyup(function (e) {
            if (e.which == 13) {
                $(this).blur();
            }
        });

        // event enter
        $('#keyword').keypress(function (e) { return e.which != 13; });
	</script>
