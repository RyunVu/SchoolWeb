@using VNPT.Web.Portal.Api.Helper

@model VNPT.Web.Portal.Api.DTO.MetaData

@{
	Layout = null;
}
<title>@Html.Raw(Model.Title)</title>
<meta name="description" content="@Html.Raw(Model.Description)">
<meta name="og:title" property="og:title" content="@Html.Raw(Model.Title)">
<meta name="robots" content="@Html.Raw(Model.Robots)">
<meta name="keywords" content="@Html.Raw(Model.Keywords)">
<meta name="subject" content="@Html.Raw(Model.Description)">
<meta name="copyright" content="VNPT LDG">
<meta name="language" content="@Html.Raw(Model.Language)">
<meta property="og:site_name" content="@Model.SiteName" />
<meta property="og:rich_attachment" content="true" />
<meta property="og:type" content="website" />
<meta property="og:image" content="@(Url.Image(Model.ImageThumbFacebook ?? ""))" />
<meta property="og:image:width" content="@Model.ImageThumbFacebookWidth" />
<meta property="og:image:height" content="@Model.ImageThumbFacebookHeigth" />

<!-- GENERAL GOOGLE SEARCH META -->
<script type="application/ld+json">
    {
    "@@context" : "http://schema.org",
    "@@type" : "WebSite",
    "name" : "@Html.Raw(Model.Title)",
    "alternateName" : "@Html.Raw(Model.Description)",
    "dateModified": "",
    "url" : ""
    }
</script>