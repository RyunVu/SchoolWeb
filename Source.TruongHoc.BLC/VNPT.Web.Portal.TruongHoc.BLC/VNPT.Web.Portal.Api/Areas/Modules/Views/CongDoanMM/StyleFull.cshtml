@using VNPT.Core.Constants
@using VNPT.Web.Portal.Api.DTO
@using VNPT.Web.Portal.Api.Helper
@using VNPT.Web.Portal.Api.Models
@using VNPT.Web.Portal.Base

@model List<News>
@{
	var information = Session["PortalInformation"] as PortalInformation;
}
@{
	var first = Model.FirstOrDefault();
}

<div class="box-news-home">
	@if (first != null)
	{
		<div class="box-news-home_left item">
			<a class="img" href="@Url.Site("chi-tiet-tin-tuc", parameter: new { param = first.Alias })" title="@first.Title">
				<img class="image-border" src="@(first.ImageUrl != null ? Url.Image(first.ImageUrl) : Html.Raw("/Images/noimage.png"))" alt="@first.Title">
			</a>
			<div class="title">
				<h4><a href="@Url.Site("chi-tiet-tin-tuc", parameter: new { param = first.Alias })" title="@first.Title">@first.Title</a></h4>
				<span class="time">
					<i class="fa fa-clock-o"></i>@first.CreateDate.ToString("dd/MM/yyyy")
					<span style="padding-left: 5%;"><i class="fa fa-eye"></i>@first.CountView lượt xem</span>
				</span>

			</div>
		</div>
	}
	<div class="box-news-home_center item">
		@foreach (var item in Model.Skip(1).Take(3))
		{
			<div class="item-center">
				<a class="img" href="@Url.Site("chi-tiet-tin-tuc", parameter: new { param = item.Alias })" title="@item.Title">
					<img src="@(item.ImageUrl != null ? Url.Image(item.ImageUrl) : Html.Raw("/Images/noimage.png"))" alt="@item.Title">
				</a>
				<div class="title">
					<h4><a href="@Url.Site("chi-tiet-tin-tuc", parameter: new { param = item.Alias })" title="@item.Title">@item.Title</a></h4>

				</div>
			</div>
		}
	</div>

	<div class="box-news-home_right item">
		<ul>
			@foreach (var item in Model.Skip(4).Take(5))
			{
				<li><a href="@Url.Site("chi-tiet-tin-tuc", parameter: new { param = item.Alias })" title="@item.Title">@item.Title</a></li>
			}
		</ul>
	</div>
</div>

