<div class="box-news-haft">
	<div class="item_box_img">
		@foreach (var item in Model.Take(1))
		{
			<a href="@Url.Site("chi-tiet-tin-tuc", parameter: new { param = item.Alias })" title="@item.Title">
				<img src="@(item.ImageUrl != null ? Url.Image(item.ImageUrl) : Html.Raw("/Images/noimage.png"))" alt="@item.Title" style="object-position: center; object-fit: cover">
			</a>
			<div class="title_box">
				<a href="@Url.Site("chi-tiet-tin-tuc", parameter: new { param = item.Alias })">@item.Title</a>

			</div>
		}
	</div>
	<div class="item_box_text">
		<ul>
			@foreach (var item in Model.Skip(1).Take(4))
			{
				<li>
					<a href="@Url.Site("chi-tiet-tin-tuc", parameter: new { param = item.Alias })" title="@item.Title">
						@item.Title
					</a>
				</li>

			}
		</ul>
	</div>
</div>

