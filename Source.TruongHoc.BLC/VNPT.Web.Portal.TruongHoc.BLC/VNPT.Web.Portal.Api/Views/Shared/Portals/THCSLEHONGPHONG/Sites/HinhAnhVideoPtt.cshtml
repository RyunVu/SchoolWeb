@using VNPT.Web.Portal.Api.DTO
@using VNPT.Web.Portal.Api.Code
@using VNPT.Web.Portal.Api.Models
@using VNPT.Web.Portal.Api.Helper
@{
    Layout = "~/Views/Shared/Portals/Layouts/PhongTruyenThongTheme/_PhongTruyenThongLayout2.cshtml";
    var information = Session["PortalInformation"] as PortalInformation;

    var nameCongThongTin = SystemParameterDto.GetParameter("FOOTER", "NAME", information.PortalCode.ToUpper()).Value2;
    //var logo = Url.Image(SystemParameterDto.GetParameter("FOOTER", "LOGO", information.PortalCode.ToUpper()).Value2);
    var codeFromUrl = Request.QueryString["Code"]; // Lấy Code từ URL
}

@{
    var code = Request.QueryString["param"] != null ? Request.QueryString["param"].ToLower() : "";
    var linkImg = SystemParameterDto.GetParameter("MEDIAURL", null, information.PortalCode.ToUpper()).Value2;

    HttpCookie cookie = Request.Cookies["Language_Portal"];

    string lang = "vi";

    if (cookie != null)
    {
        lang = cookie.Value;
    }

    var menuSite = GeneralCategoryDto.GetNameNewsType(code, information.PortalCode.ToUpper());

    var codename = menuSite?.Name;
    var codesite = menuSite?.Value;

    if (lang != "vi")
    {
        codename = GeneralCategoryDto.GetNameNewsType(code, information.PortalCode.ToUpper()).Name_En;
    }
}

@section MetaData {
    @Html.Action("Index", "Metadata", new { area = "Modules", Type = MetaDataType.Portal, Keywords = ViewBag.Tag, Title = ViewBag.Title, Description = ViewBag.Description })
}

@section pluginStyles {

}

<style>
    .content-gd .itemgd {
        box-shadow: 2px 2px 20px #00000017;
        border-radius: 10px;
        overflow: hidden;
        margin: 0 11px 23px 0;
    }

        .content-gd .itemgd img {
            height: 227px;
            width: 100%;
            -o-object-fit: cover;
            object-fit: cover;
            transition: 0.5s;
        }

        .content-gd .itemgd .icon_item {
            position: absolute;
            left: 50%;
            top: 50%;
            transform: translate(-50%, -50%);
            padding: 10px 17px;
            background: rgba(176, 17, 22, 0.65);
            border-radius: 10px;
        }

            .content-gd .itemgd .icon_item i {
                font-size: 50px;
                opacity: 0.8;
                color: #fff;
            }

    /* Trưng bày hiện vật và hình ảnh video */
    .content-media img.img_hover {
        height: 250px !important;
    }

    .content-media img.thanhtich {
        height: 227px !important;
    }

    .content-media .gd-title {
        font-size: 16px !important;
        line-height: 25px !important;
        margin-bottom: 0 !important;
        font-weight: 500 !important;
        color: #000;
    }

    .content-gd .itemgd-body {
        padding: 14px 20px !important;
        background-color: #fff;
    }

        .content-gd .itemgd-body a {
            min-height: 50px;
        }

    .content-gd .gd-title {
        margin-bottom: 10px;
        font-size: 20px;
        font-weight: bold;
        overflow: hidden;
        text-overflow: ellipsis;
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        line-height: 25px;
    }

    .content-gd .gd-des {
        font-size: 16px;
        text-align: justify;
        max-height: 80px;
        min-height: 80px;
        overflow: hidden;
    }

</style>

<input id="nameCongThongTin" value="@nameCongThongTin" type="hidden" />

<div class="body-content">
    <div class="container">
        <div class="content-title text-center">
            <div class="c-title">
                <span>@codename</span>
            </div>
        </div>

        <div class="row content-gd content-media">
            <div class="col-sm-12">
                <h4 style="font-weight: bold;">HÌNH ẢNH</h4>
            </div>

            <div id="hinhAnh">
                
            </div>

            <div class="col-sm-12">
                <h4 style="font-weight: bold;">VIDEO</h4>
            </div>

            <div class="col-sm-3" *ngFor="let item of lstVD; let i = index">
                <div class="itemgd">
                    <a (click)="clickVideo(i)" class="link_item">
                        <img class="img_hover" src="{{item.ImageUrl}}" onerror="onerror=null;src='assets/img/Noimage.jpg';" />
                    </a>
                    <div class="itemgd-body">
                        <a (click)="clickVideo(i)" class="gd-title">
                            {{item.Name}}
                        </a>
                    </div>
                </div>
            </div>


        </div>

        @*@Html.Action("DanhSachBaiVietPtt", "PhongTruyenThong", new { area = "Modules", Code = codesite })*@
    </div>
</div>

<script id="hinhAnhHtml" type="x-tmpl-mustache">
    {{#dataHinhAnh}}
        <div class="col-sm-3">
            <div class="itemgd">
                <a class="link_item">
                    <img class="img_hover" src="{{ImageUrl}}" onerror="onerror=null;src='assets/img/Noimage.jpg';" />
                </a>
                <div class="itemgd-body">
                    <a class="gd-title">{{Title}}</a>
                </div>
            </div>
        </div>
    {{/dataHinhAnh}}
</script>

@section scripts {
    <script type="text/javascript">

        var domainMedia = '@System.Configuration.ConfigurationManager.AppSettings["DomainMedia"]';
        var urlTemplate = "@Url.Site("phong-truyen-thong/chi-tiet-can-bo", parameter: new { param = "__value__" })";
        const template = $("#itemNhiemKy").html();


        var main = {
            loadCanBos: function () {
                var obj = {
                    Id: "@code",
                    UnitCode: "@information.PortalCode"
                }
                $.ajax({
                    type: "POST",
                    data: JSON.stringify(obj),
                    url: '/api/NhiemKy/GetNhiemKy',
                    contentType: "application/json",
                    dataType: "json",
                    beforeSend: function () {
                        //if (isloading) {
                        //    loading.showLoading();
                        //}
                    },
                    success: function (res) {

                        console.log(res)

                        const processedData = res.Result.CVNKlst.map(item => ({
                            ...item,
                            CBCVNKlst: item.CBCVNKlst.map(cbcv => ({
                                ...cbcv,
                                NgaySinhString: cbcv.NgaySinh
                                    ? new Date(cbcv.NgaySinh).toLocaleDateString("vi-VN")
                                    : "N/A",
                                UrlCanBo: urlTemplate.replace("__value__", cbcv.TieuSuId),
                                offsetClass: item.CBCVNKlst.length == 1 ? "col-sm-offset-3" : ""
                            }))
                        }));

                        const template = $("#dsCanBoHtml").html();

                        const rendered = Mustache.render(template, { dataList: processedData });

                        $("#dsCanBo").html(rendered);
                    },
                });
            }
        }

        $(document).ready(function () {
            main.loadCanBos();
        })

    </script>
}
