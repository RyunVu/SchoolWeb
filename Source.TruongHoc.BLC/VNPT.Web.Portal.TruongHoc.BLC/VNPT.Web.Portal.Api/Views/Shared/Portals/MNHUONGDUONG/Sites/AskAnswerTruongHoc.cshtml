<script id="result_data" type="x-tmpl-mustache">
    <section class="post-details">
        <div class="item-answer ">
            <h3 class="cls-h3">Nội dung câu trả lời</h3>
            <p class="cls-header">Trả lời bởi:  {{NAME}} - Ngày trả lời: {{CREATE}}</p>
            <p class="cls-subject">Chủ đề: {{SUBJECT}}</p>
            <p>{{{CONTENT}}}</p>
        </div>
    </section>
</script>
@section scripts {
	<script>
            $('.item-detail').on('click', function () {
                var idPro = $(this).attr('data-id');
                $.ajax({
                    type: 'POST',
                    url: '@Url.Action("GetDetailAnswer", "CongDoanMM", new { area = "Modules" })',
                    data: {
                        id: idPro,
                    },
                    success: function (response) {
                        if (response.success) {
                            var data = response.data;
                            var template = $('#result_data').html();

                            var html = Mustache.render(template,
                                {
                                    NAME: data.NAME,
                                    CONTENT: data.CONTENT,
                                    SUBJECT: data.SUBJECT,
                                    CREATE: data.CREATE
                                });

                            $('#detailQA').html(html);

                            setTimeout(function () {
                                jQuery.magnificPopup.open({
                                    removalDelay: 500,
                                    items: {
                                        src: '#detailQA'
                                    },
                                    callbacks: {
                                        beforeOpen: function (e) {
                                            this.st.mainClass = 'mfp-zoom-in';
                                        },
                                        close: function (e) {
                                        }
                                    },
                                    midClick: true,
                                    closeOnBgClick: true
                                });

                            }, 10);
                        }
                    },
                    error: function () {
                        console.log("Error connection!");
                    },
                    timeout: 100000
                });

            });
	</script>
}
