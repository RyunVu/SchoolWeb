@using VNPT.Web.Portal.Base
@using VNPT.Web.Portal.Api.Helper
@using VNPT.Web.Portal.Api.Code
@using VNPT.Web.Portal.Api.DTO
@using VNPT.Web.Portal.Api.Code
@using VNPT.Web.Portal.Api.Models

@{
    var information = Session["PortalInformation"] as PortalInformation;
    var nameCongThongTin = SystemParameterDto.GetParameter("FOOTER", "NAME", information.PortalCode.ToUpper()).Value2;
    var logo = Url.Image(SystemParameterDto.GetParameter("FOOTER", "LOGO", information.PortalCode.ToUpper()).Value2);
}


<style>
    .top-bar {
        background-image: linear-gradient(#0086f4, #006ac1);
        padding: 15px 0;
    }

        .top-bar .top-bar-right .socials {
            float: right;
            margin: 0;
            padding: 0;
        }

            .top-bar .top-bar-right .socials li, .top-bar .top-bar-left .socials li {
                display: inline-block;
                float: left;
                font-size: 15px;
                margin: 9px;
            }

        .top-bar a.social-icon.text-dark {
            color: red !important;
            font-weight: bold;
            font-size: 15pt;
            text-shadow: 0.5px 0 0 #fff, 0.5px 0 0 #fff, 0.5px 0.5px 0 #fff, 0.5px -0.5px 0 #fff;
            text-transform: uppercase;
        }
</style>

<div class="top-bar">
    <div class="container">
        <div class="row">
            <div class="col-12 col-sm-12">
                <div class="top-bar-right">
                    <ul class="socials">
                        <li style="padding: 0; margin: 0;">
                            <img width="35px" src="@logo" style="border-radius: 50%; background-color: #fff;">
                        </li>
                        <li class="hidden-md-down"><a class="social-icon text-dark ng-binding">Truyền thống @nameCongThongTin</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
