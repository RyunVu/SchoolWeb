                                </li>
                            }*@

                    </ul>
                </div>
            </div>
        }
        else if (systemMenu.MenuType == 6)
        {
            <div class="inline-block">
                <div class="site_block_title">
                    <h3>
                        <a href="#" class="titlepgddt">
                            <img class="iconp" src="~/Images/pgddt/image.png" />
                            @SystemParameterDto.Translate(systemMenu.Title)
                        </a>
                    </h3>
                </div>

                @Html.Action("NewsHinh1Sidebar", "PhongGDDT_Sidebar", new { area = "Modules", Code = systemMenu.Parameter })
            </div>
        }
        else if (systemMenu.MenuType == 8)
        {
            <div class="inline-block">
                <div class="site_block_title">
                    <h3>
                        <a href="#" class="titlepgddt">
                            <img class="iconp" src="~/Images/pgddt/video.png" />
                            @SystemParameterDto.Translate(systemMenu.Title)
                        </a>
                    </h3>
                </div>

                @Html.Action("Video1Sidebar", "PhongGDDT_Sidebar", new { area = "Modules", Code = systemMenu.Parameter })
            </div>
        }
    }

