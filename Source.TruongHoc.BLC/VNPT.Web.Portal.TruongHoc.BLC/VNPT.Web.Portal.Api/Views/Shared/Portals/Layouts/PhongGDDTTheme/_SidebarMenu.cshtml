<div class="sidebar" id="lstLinkBotton">

    <div class="inline-block">
        <div class="site_block_title">
            <h3>
                <a href="#" class="titlepgddt">
                    <img class="iconp" src="~/Images/pgddt/link.png" />
                    Các website trực thuộc
                </a>
            </h3>
        </div>

        @Html.Action("WebsiteTrucThuoc", "PhongGDDT_Sidebar", new { area = "Modules", Code = "thong-bao.0f60793f-d8ca-4638-bc06-22b5f9ba560f" })
    </div>

    @foreach (var systemMenu in menus)
    {
        if (systemMenu.MenuType == 1)
        {
            <div class="inline-block">
                <div class="leftmenu">
                    <div class="site_block_title">
                        <h3>
                            <a>
                                <i class="fa fa-list"></i>
                                @SystemParameterDto.Translate(systemMenu.Title)
                            </a>
                        </h3>
                    </div>
                    <ul class="nav-left statis-news">
                        @Html.Action("GetNews", "PhongGDDT_Sidebar", new { area = "Modules", Code = systemMenu.Parameter })
                    </ul>
                </div>
            </div>
        }
        else if (systemMenu.MenuType == 2)
        {
            //Tin tức chạy
            <div class="inline-block">
                <div class="">
                    <div class="site_block_title">
                        <h3>
                            <a>
                                <i class="fa fa-list"></i>
                                @SystemParameterDto.Translate(systemMenu.Title)
                            </a>
                        </h3>
                    </div>
                    <ul class="nav-left scrolling-news" style="overflow: hidden">
                        @Html.Action("ScrollingNews", "PhongGDDT_Sidebar", new { area = "Modules", Code = systemMenu.Parameter })
                    </ul>
                </div>
            </div>
        }
        else if (systemMenu.MenuType == 3)
        {
            @Html.Action("LinkSidebar", "PhongGDDT_Sidebar", new { area = "Modules", Code = systemMenu.Parameter })
        }
        else if (systemMenu.MenuType == 4)
        {
            @Html.Action("LinkSidebar", "PhongGDDT_Sidebar", new { area = "Modules", Code = systemMenu.Parameter })
        }

        else if (systemMenu.MenuType == 5)
