                        </h3>
                    </div>
                    <ul class="nav-left scrolling-news" style="overflow: hidden">
                        @Html.Action("ScrollingNews", "Sidebar", new { area = "Modules", Code = systemMenu.Parameter })
                    </ul>
                </div>
            </div>
        }
        else if (systemMenu.MenuType == 3)
        {
            @Html.Action("LinkSidebar", "Sidebar", new { area = "Modules", Code = systemMenu.Parameter })
        }
        else if (systemMenu.MenuType == 4)
        {
