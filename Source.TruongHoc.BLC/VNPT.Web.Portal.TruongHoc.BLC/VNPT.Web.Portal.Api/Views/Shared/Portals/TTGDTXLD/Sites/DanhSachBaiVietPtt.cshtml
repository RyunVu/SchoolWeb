@using VNPT.Web.Portal.Api.DTO
@using VNPT.Web.Portal.Api.Code
@using VNPT.Web.Portal.Api.Models
@using VNPT.Web.Portal.Api.Helper
@{
    Layout = "~/Views/Shared/Portals/Layouts/PhongTruyenThongTheme/_PhongTruyenThongLayout2.cshtml";
    var information = Session["PortalInformation"] as PortalInformation;

    var nameCongThongTin = SystemParameterDto.GetParameter("FOOTER", "NAME", information.PortalCode.ToUpper()).Value2;
    //var logo = Url.Image(SystemParameterDto.GetParameter("FOOTER", "LOGO", information.PortalCode.ToUpper()).Value2);
    var codeFromUrl = Request.QueryString["Code"]; // Lấy Code từ URL
}

@{
    var code = Request.QueryString["param"] != null ? Request.QueryString["param"].ToLower() : "";
    var linkImg = SystemParameterDto.GetParameter("MEDIAURL", null, information.PortalCode.ToUpper()).Value2;

    HttpCookie cookie = Request.Cookies["Language_Portal"];

    string lang = "vi";

    if (cookie != null)
    {
        lang = cookie.Value;
    }

    var menuSite = GeneralCategoryDto.GetNameNewsType(code, information.PortalCode.ToUpper());

    var codename = menuSite?.Name;
    var codesite = menuSite?.Value;

    if (lang != "vi")
    {
        codename = GeneralCategoryDto.GetNameNewsType(code, information.PortalCode.ToUpper()).Name_En;
    }
}

@section MetaData {
    @Html.Action("Index", "Metadata", new { area = "Modules", Type = MetaDataType.Portal, Keywords = ViewBag.Tag, Title = ViewBag.Title, Description = ViewBag.Description })
}

