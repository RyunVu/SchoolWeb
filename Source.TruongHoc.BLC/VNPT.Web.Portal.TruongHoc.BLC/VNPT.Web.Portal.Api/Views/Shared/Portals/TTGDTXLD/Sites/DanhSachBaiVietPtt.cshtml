    <script type="text/javascript">

        var domainMedia = '@System.Configuration.ConfigurationManager.AppSettings["DomainMedia"]';
        var urlTemplate = "@Url.Site("phong-truyen-thong/chi-tiet-bai-viet", parameter: new { param = "__value__" })";
        const template = $("#listNews").html();

        var commonConfig = {
            pageSize: 12,
            page: 1,
            isClear: 0,
        }

        var codeAlias = '@code'.split('.')[0];

        var obj = {
            PageIndex: commonConfig.page,
            PageSize: commonConfig.pageSize,
            UnitCode: "@information.PortalCode",
            Code: codeAlias ? codeAlias : ''
        };

        if (codeAlias == "hinh-anh-video-ptt") {
            obj = {
                PageIndex: 1,
                PageSize: 100,
                UnitCode: "@information.PortalCode",
                Code: codeAlias ? codeAlias : ''
            };
        }

        var main = {
            loadListNews: function () {
                $.ajax({
                    type: "POST",
                    data: obj,
                    url: '/api/NewGuest/GetList',
                    beforeSend: function () {
                        //if (isloading) {
                        //    loading.showLoading();
                        //}
                    },
                    success: function (res) {
                        if (res.Result.length > 0) {
                            console.log(JSON.stringify(res));

                            const regExp = /^(http|https|ftp):\/\//i;

                            const processedData = res.Result.map(item => {
                                let imageUrl = item.ImageUrl && regExp.test(item.ImageUrl) ? item.ImageUrl : item.ImageUrl;

                                if (item.ImageUrl && item.ImageUrl !== 'null') {
                                    imageUrl = domainMedia + imageUrl;
                                } else {
                                    imageUrl = "/Images/NoImage400x266.png";
                                }

                                // Kiểm tra xem Description có dữ liệu hình ảnh không
                                let isImagePost = false;
                                let imageGallery = [];

                                if (item.Description) {
                                    try {
                                        const images = JSON.parse(item.Description);
                                        if (Array.isArray(images) && images.length > 0) {
                                            isImagePost = true;
                                            imageGallery = images.map(img => ({
                                                url: domainMedia + img.Url,
                                                thumb: domainMedia + img.ThumbUrl
                                            }));
                                        }
                                    } catch (e) {
                                        console.error("Lỗi parse JSON Description:", e);
                                    }
                                }

                                // Kiểm tra xem bài viết có phải là video không
                                let isVideoPost = false;
                                let videoUrl = "";

                                if (!isImagePost && item.ShortContent && regExp.test(item.ShortContent)) {
                                    isVideoPost = true;
                                    videoUrl = item.ShortContent;
                                }

                                return {
                                    ...item,
                                    ImageUrlNew: imageUrl,
                                    UrlBaiViet: urlTemplate.replace("__value__", item.Alias).replace("__code__", item.Code),
                                    isImagePost,
                                    imageGallery,
                                    isVideoPost,
                                    videoUrl
                                };
                            });

                            let template = $("#htmlNews").html();
                            let rendered = Mustache.render(template, { dataList: processedData });
                            $("#paginationholder").show();
                            $("#listNews").html(rendered);

                            if (codeAlias == "hinh-anh-video-ptt") {
                                $("#listNews").hide();
                                $("#paginationholder").hide();

                                template = $("#htmlNews-2").html();
                                rendered = Mustache.render(template, { dataList: processedData });

                                $(".flipbook").html(rendered);
                                $(".flipbook").turn();

                                console.log(processedData);
                                $(".unitname").html(processedData[0].UnitName);
                            }

                            main.pagingPage(res.TotalRow, commonConfig.isClear, function () {
                                main.loadListNews();
                            });

                        } else {
                            $("#listNews").html('<h2 class="text-center">Không có dữ liệu</h2>');
                        }
                    }
                });
            },

            //NgaySinhString: cbcv.NgaySinh
            //    ? new Date(cbcv.NgaySinh).toLocaleDateString("vi-VN")
            //    : "N/A",
            //UrlCanBo: urlTemplate.replace("__value__", cbcv.TieuSuId),
            //offsetClass: item.CBCVNKlst.length == 1 ? "col-sm-offset-3" : "",
            pagingPage: function (totalRow, isClear, callback) {
                var totalRowP = parseInt(totalRow);
                var totalPage = Math.ceil(totalRowP / commonConfig.pageSize);
                if (totalPage >= 0 && commonConfig.isClear == 0) {
                    if (totalPage == 0) {
                        totalPage = 1;
                    }
                    $('#paginationholder').html('<ul id="pagination" class="pagination"></ul>');
                }

                $('#paginationholder #pagination').twbsPagination({
                    totalPages: totalPage,
                    visiblePages: 4,
                    first: '<i class="fa fa-caret-left"></i><i class="fa fa-caret-left"></i>',
                    next: '<i class="fa fa-caret-right"></i>',
                    last: '<i class="fa fa-caret-right"></i><i class="fa fa-caret-right"></i>',
                    prev: '<i class="fa fa-caret-left"></i>',
                    initiateStartPageClick: false,
                    onPageClick: function (event, page) {
                        commonConfig.page = page;
                        commonConfig.isClear = 1
                        obj = {
                            Code: "@code",
                            PageIndex: commonConfig.page,
                            PageSize: commonConfig.pageSize,
                            UnitCode: "@information.PortalCode",
                        };
                        setTimeout(callback, 200);
                    }
                });

            }
        }

        $(document).ready(function () {
            main.loadListNews();
        });

    </script>
}
