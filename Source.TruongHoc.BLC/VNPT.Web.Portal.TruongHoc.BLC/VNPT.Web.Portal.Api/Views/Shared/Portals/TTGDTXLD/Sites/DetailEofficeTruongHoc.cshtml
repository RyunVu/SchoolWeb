        $("#vanBanDetail").on('click', '.viewFileIframe', function () {
            var link = $(this).attr('data-href');
            if (link.startsWith("http://")) {
                link = link.replace("http://", "https://");
            }

            var decodeLink = decodeURI(link);

            $("#showFile").attr('src', decodeLink).show();
        })

        

        @*function parseNestedXml(element, obj) {
            for (let i = 0; i < element.children.length; i++) {
                const child = element.children[i];
                obj[child.nodeName] = {};

                // Iterate through the child's attributes
                for (let j = 0; j < child.attributes.length; j++) {
                    const attribute = child.attributes[j];
                    obj[child.nodeName][attribute.nodeName] = attribute.nodeValue;
                }

                // Recursively iterate through the child's children
                if (child.children.length > 0) {
                    obj[child.nodeName] = parseNestedXml(child, obj[child.nodeName]);
                } else {
                    obj[child.nodeName]["#text"] = child.textContent;
                }
            }

            return obj;
        }

        var commonConfig = {
            pageSize: 25,
            pageNum: 1,
            isClear: 0,
            type: ""
        };

        var skip = commonConfig.pageSize * (commonConfig.pageNum - 1);

        var obj = {
            pageNum: commonConfig.pageNum,
            pageSize: commonConfig.pageSize
        };

        var main = {
            loadDocTypeList: function () {
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("GetListCategory", "EOfficeDoc", new { area = "Modules", Code = CategoryCode.LOAIVANBAN })',
                    headers: { "Accept": "application/json; odata=verbose; charset=utf-8" },
                    beforeSend: function () {

                    },
                    success: function (res) {
                        var htmlLoaiVanBan = '';
                        htmlLoaiVanBan += '<option value ="">-- Toàn bộ --</option>';
                        $.each(res, function (key, item) {
                            htmlLoaiVanBan += '<option value ="' + item.ID + '">' + item.NAME + '</option>';
                        });
                        $("#loaiVanBan").append(htmlLoaiVanBan);
                    },
                });
            },
            loadFieldList: function () {
                $.ajax({
                    type: "POST",
                    url: '@Url.Action("GetListCategory", "EOfficeDoc", new { area = "Modules", Code = CategoryCode.LINHVUC })',
                    headers: { "Accept": "application/json; odata=verbose; charset=utf-8" },
