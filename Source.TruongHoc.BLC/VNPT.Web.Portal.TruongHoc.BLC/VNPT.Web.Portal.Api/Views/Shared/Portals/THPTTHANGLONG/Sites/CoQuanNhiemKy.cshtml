<style>
    .dsnhiemky {
        margin-top: 30px;
        position: relative;
        margin: 0 auto;
    }

        .dsnhiemky .nhiemky_item {
            padding: 10px 40px !important;
            position: relative;
            background-color: inherit;
            width: 50% !important;
            cursor: pointer;
        }

            .dsnhiemky .nhiemky_item img {
                width: 160px;
                float: left;
            }

            .dsnhiemky .nhiemky_item .nhiemky_right {
                float: left;
                padding-left: 10px;
            }

                .dsnhiemky .nhiemky_item .nhiemky_right .nhiemky_title {
                    font-size: 15px;
                    padding-top: 10px;
                    color: #000
                }

                .dsnhiemky .nhiemky_item .nhiemky_right .nhiemky_info {
                    font-size: 16px;
                    color: #007ade;
                    display: block;
                    font-weight: 600;
                    margin-top: 10px;
                }

            .dsnhiemky .nhiemky_item .nk_content {
                padding: 20px 30px;
                position: relative;
                border-radius: 6px;
                border: 2px solid #efefef;
                display: inline-block;
                width: 100%;
                background-color: #f6f6f6;
            }

            .dsnhiemky .nhiemky_item::after {
                content: "";
                position: absolute;
                width: 25px;
                height: 25px;
                right: -12px;
                background-color: red;
                border: 4px solid #ff9f55;
                top: 15px;
                border-radius: 50%;
                z-index: 2221;
            }

        /* Định vị trí container bên trái */
        .dsnhiemky .nk_left {
            left: 0;
        }

        /* Định vị trí container bên phải */
        .dsnhiemky .nk_right {
            left: 50%;
        }

        .dsnhiemky .nk_left::before {
            content: " ";
            height: 0;
            position: absolute;
            top: 22px;
            width: 0;
            z-index: 22221;
            right: 30px;
            border: medium solid #efefef;
            border-width: 10px 0 10px 10px;
            border-color: transparent transparent transparent #efefef;
        }

        .dsnhiemky .nk_right::before {
            content: " ";
            height: 0;
            position: absolute;
            top: 22px;
            width: 0;
            z-index: 1;
            left: 30px;
            border: medium solid #efefef;
            border-width: 10px 10px 10px 0;
            border-color: transparent #efefef transparent transparent;
        }

        .dsnhiemky .nk_right::after {
            left: -13px;
        }

        .dsnhiemky .nk_content:hover,
        .dsnhiemky .nk_content:active {
            border: 2px solid orange;
            background-image: linear-gradient(-70deg, #fff, #fff 70%, #ffaa00);
            transition: 0.2s;
        }

        .dsnhiemky .nk_left:hover::before:active {
            border-color: transparent transparent transparent #ffaa00;
        }

        .dsnhiemky .nk_right:hover::before:active {
            border-color: transparent #ffaa00 transparent transparent;
        }

        .dsnhiemky::after {
            content: "";
            position: absolute;
            width: 6px;
            background-color: #ff9f55;
            top: 0;
            bottom: 0;
            left: 50%;
            margin-left: -3px;
        }

    .nhiemky_scroll {
        /* max-height: 800px; */
        /* overflow-y: scroll; */
    }

    .topItemChuNhiem {
        display: flex;
        align-items: center;
        justify-content: center;
    }
</style>

