@section scripts {
    <script type="text/javascript">
        var domainMedia = '@System.Configuration.ConfigurationManager.AppSettings["DomainMedia"]';
        var urlTemplate = "@Url.Site("phong-truyen-thong/ds-canbo", parameter: new { nhiemky = "__value__" })";
        const template = $("#itemNhiemKy").html();

        var main = {
            loadNhiemKys: function () {
                var obj = {
                    Code: "@code",
                    UnitCode: "@information.PortalCode"
                }
                $.ajax({
                    type: "POST",
                    data: JSON.stringify(obj),
                    url: '/api/NhiemKy/ListFull',
                    contentType: "application/json", 
                    dataType: "json",
                    beforeSend: function () {
                        //if (isloading) {
                        //    loading.showLoading();
                        //}
                    },
                    success: function (res) {

                        const processedData = res.Result.map((item, index) => ({
                            ...item,
                            positionClass: index % 2 === 0 ? "nk_left" : "nk_right",
                            UrlNhiemKy: urlTemplate.replace("__value__", item.Id)
                        }));

                        const template = $("#itemNhiemKy").html();

                        const rendered = Mustache.render(template, { dataList: processedData });

                        $("#htmlNhiemKy").html(rendered);
                    },
                });
            }
        }

        $(document).ready(function () {
            main.loadNhiemKys();
        })
    </script>
}
