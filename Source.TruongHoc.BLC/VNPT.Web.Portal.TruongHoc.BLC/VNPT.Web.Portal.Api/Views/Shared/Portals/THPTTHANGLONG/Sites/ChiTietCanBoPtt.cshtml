<input id="nameCongThongTin" value="@nameCongThongTin" type="hidden" />

<div class="body-content">

    <div class="container">
        <div class="container_content" id="renderTieuSu">
            
        </div>
    </div>
</div>

<script id="chiTietTieuSu" type="x-tmpl-mustache">
    <div class="col-sm-12 banner_logo">
        <img src="@logo">
    </div>

    <div class="row">
        <div class="col-sm-9">
            <div class="tieusu_chucvu">
                <h3 class="tieusu_hoten">{{contentData.HoTen}}</h3>
            </div>
            <div class="tieusu_info">
                <p><span>Họ và tên thật: </span>{{contentData.HoTen}}</p>
                <p><span>Họ và tên thường gọi: </span>{{contentData.Alias}}</p>
                {{#contentData.BiDanh}}
                <p><span>Bí danh: </span>{{contentData.BiDanh}}</p>
                {{/contentData.BiDanh}}
                <p><span>Sinh ngày: </span>{{contentData.NgaySinhString}}</p>
                <p><span>Quê quán: </span>{{contentData.QueQuan}}</p>
                <p><span>Chỗ ở hiện nay: </span>{{contentData.NoiThuongTru}}</p>
                <p><span>Dân tộc: </span>{{contentData.DanToc}}</p>
                <p><span>Tôn giáo: </span>{{contentData.TonGiao}}</p>
                <p><span>Ngày vào Đảng Cộng sản Việt Nam: </span>{{contentData.NgayVaoDangString}}</p>
                <p><span>Ngày chính thức: </span>{{contentData.NgayChinhThucString}}</p>

                {{#contentData.TrinhDoChuyenMon}}
                <p>
                    <span>Trình độ chuyên môn: </span>{{contentData.TrinhDoChuyenMon}}
                </p>
                {{/contentData.TrinhDoChuyenMon}}

                {{#contentData.TrinhDoLyLuanChinhTri}}
                <p>
                    <span>
                        Trình độ lý luận chính trị:
                    </span>{{contentData.TrinhDoLyLuanChinhTri}}
                </p>
                {{/contentData.TrinhDoLyLuanChinhTri}}
            </div>
            <div class="tieusu_info">
                <div class="tieusu_info_2">
                    {{#contentData.ChucVuLst}}
                    <p>
                        <span class="name"><i class="fa fa-file-text" aria-hidden="true"></i> Chức vụ: </span>
                        <span class="lst_chucvu">
                        {{#contentData.ChucVuLst}}
                            <b>{{.}}</b>
                        {{/contentData.ChucVuLst}}
                        </span>
                    </p>
                    {{/contentData.ChucVuLst}}

                    {{#contentData.KhenThuongLst}}
                    <p>
                        <span class="name"><i class="fa fa-file-text" aria-hidden="true"></i> Khen thưởng: </span>
                        <span class="lst_chucvu">
                            {{#contentData.KhenThuongLst}}
                            <b>{{.}}</b>
                            {{/contentData.KhenThuongLst}}
                        </span>
                    </p>
                    {{/contentData.KhenThuongLst}}
                </div>
            </div>
        </div>

        <div class="row col-sm-3">
            <div class="tieusu_avatar text-center">
                <div class="news-carousel">
                    {{#contentData.ImageAvatar}}
                    <img data-fancybox="avatar" src="{{Url}}" alt="carousel" width="100%" style="object-fit: cover">
                    {{/contentData.ImageAvatar}}
                </div>
            </div>
        </div>
    </div>

    <div class="col-sm-12">
        <div class="tieusu_content">
            <ul class="nav nav-tabs nav-custom" id="custom-content-below-tab" role="tablist">
                <li class="nav-item active">
                    <a class="nav-link active" id="navqt-tab" data-toggle="pill" href="#navqt" role="tab">
                        <span>Quá trình công tác</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" id="navha-tab" data-toggle="pill" href="#navha" role="tab">
                        <span>Hình ảnh hoạt động</span>
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" id="navnd-tab" data-toggle="pill" href="#navnd" role="tab">
                        <span>Các nội dung, bài phát biểu</span>
                    </a>
                </li>
            </ul>

            <div class="tab-content row" id="custom-content-below-tabContent">
                <div class="tab-pane active in" id="navqt" role="tabpanel" aria-labelledby="navqt-tab">
                    <div class="timeline_qtct">
                        <div class="box-content">
                            {{#contentData.QTCTlst}}
                            <div class="item">
                                <div class="year">
                                    <span>Từ {{TuNgayDenNgay}}</span>
                                </div>

                                <div class="title">
                                    {{NoiDung}}
                                </div>
                            </div>
                            {{/contentData.QTCTlst}}
                        </div>
                    </div>

                </div>
                <div class="tab-pane fade" id="navha" role="tabpanel" aria-labelledby="navha-tab">
                    <div class="lstimage">
                        {{#contentData.imageList}}
                        <div class="contentimg col-sm-3" onclick="imageClick({{index}})">
                            <img data-fancybox="navha-tab" src="{{Url}}" alt="{{alt}}" style="cursor: pointer" />
                        </div>
                        {{/contentData.imageList}}

                        {{#contentData.hasMoreImages}}
                        <div class="contentimg col-sm-3 content-overlay" onclick="imageClick(7)">
                            <img data-fancybox="navha-tab" src="{{contentData.imageList.6.Url}}" alt="{{contentData.imageList.6.alt}}" style="cursor: pointer" />
                            <span>+{{contentData.extraImagesCount}} hình</span>
                        </div>
                        {{/contentData.hasMoreImages}}

                    </div>
                </div>

                <div class="tab-pane fade" id="navnd" role="tabpanel" aria-labelledby="navnd-tab">
                    <div class="lstbaibao">
                        {{#contentData.BPBlst}}
                        <a href="{{LinkBaiViet}}" target="_blank">
                            <i class="fa fa-caret-right"></i> {{TieuDe}}
                        </a>
                        {{/contentData.BPBlst}}
                    </div>
                </div>
            </div>
        </div>
    </div>
</script>

@section scripts {
    <script type="text/javascript">
        var domainMedia = '@System.Configuration.ConfigurationManager.AppSettings["DomainMedia"]';
        var urlTemplate = "@Url.Site("phong-truyen-thong/chi-tiet-tin-tuc", parameter: new { param = "__canboid__" })";
        var Id = "@(Request.QueryString["param"] != null ? Request.QueryString["param"].ToLower() : "")";
        const template = $("#chiTietTieuSu").html();

        var main = {
            loadChiTietTieuSu: function () {
                var obj = {
                    Id: Id,
                };
                $.ajax({
                    type: "POST",
                    data: JSON.stringify(obj),
                    url: '/api/TieuSu/GetTieuSu',
                    contentType: "application/json",
                    dataType: "json",
                    beforeSend: function () {
                        //if (isloading) {
                        //    loading.showLoading();
                        //}
                    },
                    success: function (res) {
                        console.log(res);

                        const regExp = /^(http|https|ftp):\/\//i; // Regex kiểm tra URL tuyệt đối
                        res.Result["ImageAvatar"] = []; // Khởi tạo mảng rỗng để lưu danh sách ảnh

                        // Xử lý UrlAvt1
                        if (res.Result.UrlAvt1 && res.Result.UrlAvt1 !== 'null') {
                            let imageUrl1 = regExp.test(res.Result.UrlAvt1)
                                ? res.Result.UrlAvt1
                                : domainMedia + res.Result.UrlAvt1;

                            res.Result["ImageAvatar"].push({ "Url": imageUrl1 });
                        }

                        // Xử lý UrlAvt2
                        if (res.Result.UrlAvt2 && res.Result.UrlAvt2 !== 'null') {
                            let imageUrl2 = regExp.test(res.Result.UrlAvt2)
                                ? res.Result.UrlAvt2
                                : domainMedia + res.Result.UrlAvt2;

                            res.Result["ImageAvatar"].push({ "Url": imageUrl2 });
                        }

                        //res.Result.map(item => {

                        //    const regExp = /^(http|https|ftp):\/\//i;
                        //    let imageUrl = item.UrlAvt1 && regExp.test(item.UrlAvt1) ? item.UrlAvt1 : item.UrlAvt1;

                        //    if (item.UrlAvt1 && item.UrlAvt1 != 'null') {
                        //        imageUrl = domainMedia + item.URL_IMG;
                        //    } else {
                        //        imageUrl = "/Images/NoImage400x266.png";
                        //    }

                        //    return {
                        //        ...item,
                        //        URL_IMG_NEW: imageUrl,
                        //        URL_LINK: urlTemplate.replace("__canboid__", item.Id)
                        //    };
                        //});

                        const imageList = res.Result.HAHDlst.slice(0, 7).map(item => ({
                            ...item,
                            Url: regExp.test(item.Url) ? item.Url : domainMedia + item.Url
                        }));

                        const extraImagesCount = res.Result.HAHDlst.length - 7;
                        const hasMoreImages = extraImagesCount > 0;

                        const processedData = {
                            contentData: {
                                ...res.Result,
                                imageList: imageList,
                                extraImagesCount: extraImagesCount,
                                hasMoreImages: hasMoreImages,
                                BPBlst: res.Result.BPBlst.map(item => ({
                                    ...item,
                                    LinkBaiViet: urlTemplate.replace("__canboid__", item.Id)
                                }))
                            }
                        };

                        const rendered = Mustache.render(template, processedData);
                        $("#renderTieuSu").html(rendered);

                        $('.news-carousel').slick({
                            slidesToShow: 1,         
                            slidesToScroll: 1,      
                            autoplay: true,      
                            infinite: true,
                            speed: 500,
                        });
                    },
                });
            },
        }

        $(document).ready(function () {
            main.loadChiTietTieuSu();

            $('#custom-content-below-tab a').on('click', function (e) {
                e.preventDefault();
                $(this).tab('show');
                console.log("Tab đã được click:", $(this).attr("href"));
            });
        })
    </script>
}
