{
    "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
    "version": 1,
    "newProjectRoot": "projects",
    "projects": {
        "attpadmin": {
            "projectType": "application",
            "schematics": {
                "@schematics/angular:component": {
                    "style": "scss"
                },
                "@schematics/angular:application": {
                    "strict": true
                }
            },
            "root": "",
            "sourceRoot": "src",
            "prefix": "app",
            "architect": {
                "build": {
                    "builder": "@angular-devkit/build-angular:browser",
                    "options": {
                        "outputPath": "dist/attpadmin",
                        "index": "src/index.html",
                        "main": "src/main.ts",
                        "polyfills": "src/polyfills.ts",
                        "tsConfig": "tsconfig.app.json",
                        "aot": true,
                        "assets": [
                            "src/favicon.ico",
                            "src/web.config",
                            "src/assets",
                            {
                                "glob": "**/*",
                                "input": "node_modules/ngx-extended-pdf-viewer/assets/",
                                "output": "/assets/"
                            }
                        ],
                        "styles": [
                            "node_modules/primeng/resources/themes/bootstrap4-light-blue/theme.css",
                            "node_modules/primeng/resources/primeng.min.css",
                            "node_modules/primeflex/primeflex.css",
                            "node_modules/primeicons/primeicons.css",
                            "src/assets/stimulsoft/stimulsoft.viewer.office2013.whiteblue.css",
                            "node_modules/admin-lte/plugins/fontawesome-free/css/all.min.css",
                            "node_modules/quill/dist/quill.snow.css",
                            "node_modules/ngx-toastr/toastr.css",
                            "node_modules/admin-lte/dist/css/adminlte.min.css",
                            "src/styles.scss",
                            "node_modules/@syncfusion/ej2-base/styles/material.css",
                            "node_modules/@syncfusion/ej2-inputs/styles/material.css",
                            "node_modules/@syncfusion/ej2-buttons/styles/material.css",
                            "node_modules/@syncfusion/ej2-splitbuttons/styles/material.css",
                            "node_modules/@syncfusion/ej2-lists/styles/material.css",
                            "node_modules/@syncfusion/ej2-navigations/styles/material.css",
                            "node_modules/@syncfusion/ej2-popups/styles/material.css",
                            "node_modules/@syncfusion/ej2-dropdowns/styles/material.css",
                            "node_modules/@syncfusion/ej2-spreadsheet/styles/material.css",
                            "node_modules/@syncfusion/ej2-grids/styles/material.css",
                            "node_modules/@angular/material/prebuilt-themes/indigo-pink.css",
                            "src/assets/font/number/number.css",
                            "node_modules/swiper/swiper.scss"
                        ],
                        "scripts": [
                            "node_modules/jquery/dist/jquery.min.js",
                            "node_modules/bootstrap/dist/js/bootstrap.bundle.min.js",
                            "src/assets/stimulsoft/stimulsoft.reports.js",
                            "src/assets/stimulsoft/stimulsoft.viewer.js",
                            "node_modules/prismjs/prism.js",
                            "node_modules/prismjs/components/prism-typescript.js",
                            "node_modules/admin-lte/dist/js/adminlte.js",
                            "src/assets/ckeditor/ckeditor.js",
                            "src/assets/ckeditor/ckfinder.js"
                        ],
                        "allowedCommonJsDependencies": ["file-saver", "chart.js", "lodash", "highcharts/highstock"]
                    },
                    "configurations": {
                        "production": {
                            "fileReplacements": [{
                                "replace": "src/environments/environment.ts",
                                "with": "src/environments/environment.prod.ts"
                            }],
                            "optimization": true,
                            "outputHashing": "all",
                            "sourceMap": false,
                            "namedChunks": false,
                            "extractLicenses": true,
                            "vendorChunk": false,
                            "buildOptimizer": true,
                            "budgets": [{
                                    "type": "initial",
                                    "maximumWarning": "14mb",
                                    "maximumError": "15mb"
                                },
                                {
                                    "type": "anyComponentStyle",
                                    "maximumWarning": "8mb",
                                    "maximumError": "10mb"
                                }
                            ]
                        }
                    }
                },
                "serve": {
                    "builder": "@angular-devkit/build-angular:dev-server",
                    "options": {
                        "browserTarget": "attpadmin:build"
                    },
                    "configurations": {
                        "production": {
                            "browserTarget": "attpadmin:build:production"
                        }
                    }
                },
                "extract-i18n": {
                    "builder": "@angular-devkit/build-angular:extract-i18n",
                    "options": {
                        "browserTarget": "attpadmin:build"
                    }
                },
                "test": {
                    "builder": "@angular-devkit/build-angular:karma",
                    "options": {
                        "main": "src/test.ts",
                        "polyfills": "src/polyfills.ts",
                        "tsConfig": "tsconfig.spec.json",
                        "karmaConfig": "karma.conf.js",
                        "assets": [
                            "src/favicon.ico",
                            "src/assets"
                        ],
                        "styles": [
                            "src/styles.scss"
                        ],
                        "scripts": []
                    }
                },
                "lint": {
                    "builder": "@angular-devkit/build-angular:tslint",
                    "options": {
                        "tsConfig": [
                            "tsconfig.app.json",
                            "tsconfig.spec.json",
                            "e2e/tsconfig.json"
                        ],
                        "exclude": [
                            "**/node_modules/**"
                        ]
                    }
                },
                "e2e": {
                    "builder": "@angular-devkit/build-angular:protractor",
                    "options": {
                        "protractorConfig": "e2e/protractor.conf.js",
                        "devServerTarget": "attpadmin:serve"
                    },
                    "configurations": {
                        "production": {
                            "devServerTarget": "attpadmin:serve:production"
                        }
                    }
                }
            }
        }
    },
    "defaultProject": "attpadmin",
    "cli": {
        "analytics": "c4356413-525f-4d22-93c1-ad16ca8afde3"
    }
}
